+
+    /**
+     * Какая из надписей «Hayo Gram» сейчас на экране: в шапке или в блоке
+     * историй (в развёрнутом виде видна именно она). Рука идёт к ней.
+     */
+    private View hayoVisibleTitle() {
+        View best = actionBar.getTitleTextView();
+        float bestAlpha = hayoShownAlpha(best);
+        if (dialogStoriesCell != null) {
+            for (View view : dialogStoriesCell.hayoTitleViews()) {
+                final float alpha = hayoShownAlpha(view);
+                if (alpha > bestAlpha + 0.01f) {
+                    best = view;
+                    bestAlpha = alpha;
+                }
+            }
+        }
+        return best;
+    }
+
+    private static float hayoShownAlpha(View view) {
+        if (view == null || !view.isShown() || view.getWidth() == 0) return 0f;
+        float alpha = 1f;
+        for (View v = view; v != null; v = v.getParent() instanceof View ? (View) v.getParent() : null) {
+            alpha *= v.getAlpha();
+        }
+        final android.graphics.Rect rect = new android.graphics.Rect();
+        return view.getGlobalVisibleRect(rect) ? alpha : 0f;
+    }
 }
