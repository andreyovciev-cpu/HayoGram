+package org.telegram.margelet;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffColorFilter;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.BottomSheet;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.Switch;
+
+/**
+ * Установка плагина нижним листом: значок и имя сверху, описание
+ * сворачивается, разрешения списком со значками, внизу две кнопки. Вместо
+ * простыни текста в окошке посреди экрана.
+ */
+public class HayoPluginSheet extends BottomSheet {
+
+    public interface Actions {
+        void install(boolean startNow);
+        void viewSource();
+        void cancelled();
+    }
+
+    private boolean done;
+
+    public HayoPluginSheet(Context context, MargeletPlugins.Plugin plugin, MargeletPlugins.Plugin existing, Actions actions) {
+        super(context, false);
+        HayoYou.ensureRoles();
+        setApplyTopPadding(false);
+        setApplyBottomPadding(false);
+        fixNavigationBar();
+
+        final int text = Theme.getColor(Theme.key_dialogTextBlack);
+        final int gray = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2);
+        final int card = HayoYou.on() ? HayoYou.surfaceContainerHigh : Theme.getColor(Theme.key_windowBackgroundGray);
+
+        final LinearLayout root = new LinearLayout(context);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(20), dp(8), dp(20), dp(16));
+
+        // ручка
+        final View handle = new View(context);
+        handle.setBackground(round(Theme.getColor(Theme.key_sheet_scrollUp), dp(2)));
+        root.addView(handle, LayoutHelper.createLinear(32, 4, Gravity.CENTER_HORIZONTAL, 0, 6, 0, 18));
+
+        // шапка: значок, имя, версия и автор
+        final LinearLayout head = new LinearLayout(context);
+        head.setOrientation(LinearLayout.HORIZONTAL);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        final ImageView icon = new ImageView(context);
+        final Bitmap bitmap = plugin.icon();
+        if (bitmap != null) {
+            icon.setImageBitmap(bitmap);
+            icon.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            icon.setClipToOutline(true);
+            icon.setBackground(round(card, dp(16)));
+        } else {
+            icon.setImageResource(R.drawable.hayo_ic_extension);
+            icon.setScaleType(ImageView.ScaleType.CENTER);
+            icon.setColorFilter(new PorterDuffColorFilter(HayoYou.on() ? HayoYou.onPrimaryContainer : text, PorterDuff.Mode.SRC_IN));
+            icon.setBackground(round(HayoYou.on() ? HayoYou.primaryContainer : card, dp(16)));
+        }
+        head.addView(icon, LayoutHelper.createLinear(56, 56));
+        final LinearLayout names = new LinearLayout(context);
+        names.setOrientation(LinearLayout.VERTICAL);
+        final TextView name = text(context, plugin.name, 20, text);
+        name.setTypeface(AndroidUtilities.bold());
+        name.setSingleLine();
+        name.setEllipsize(TextUtils.TruncateAt.END);
+        names.addView(name);
+        String sub = plugin.version;
+        if (plugin.author != null && plugin.author.length() > 0) {
+            sub = sub + " · " + plugin.author;
+        }
+        final TextView by = text(context, sub, 14, gray);
+        if (plugin.author != null && plugin.author.startsWith("@")) {
+            by.setOnClickListener(v -> org.telegram.messenger.browser.Browser.openUrl(context, "https://t.me/" + plugin.author.substring(1)));
+        }
+        names.addView(by, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 0, 2, 0, 0));
+        head.addView(names, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f, 16, 0, 0, 0));
+        root.addView(head);
+
+        // уже стоит: обновление или та же версия
+        if (existing != null) {
+            final TextView note = text(context, existing.version.equals(plugin.version)
+                    ? LocaleController.formatString(R.string.HayoPluginSame, existing.version)
+                    : LocaleController.formatString(R.string.HayoPluginUpdate, existing.version, plugin.version), 14,
+                    HayoYou.on() ? HayoYou.onSecondaryContainer : text);
+            note.setPadding(dp(14), dp(10), dp(14), dp(10));
+            note.setBackground(round(HayoYou.on() ? HayoYou.secondaryContainer : card, dp(12)));
+            root.addView(note, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 16, 0, 0));
+        }
+
+        // описание, свёрнутое в три строки
+        if (plugin.description != null && plugin.description.length() > 0) {
+            final LinearLayout box = card(context, card);
+            final TextView title = text(context, LocaleController.getString(R.string.HayoPluginAbout), 14, Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader));
+            title.setTypeface(AndroidUtilities.bold());
+            box.addView(title);
+            final TextView body = text(context, plugin.description, 15, text);
+            body.setMaxLines(3);
+            body.setEllipsize(TextUtils.TruncateAt.END);
+            body.setLineSpacing(dp(2), 1f);
+            box.addView(body, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 6, 0, 0));
+            final TextView more = text(context, LocaleController.getString(R.string.HayoPluginMore), 14, Theme.getColor(Theme.key_windowBackgroundWhiteBlueText));
+            more.setTypeface(AndroidUtilities.bold());
+            box.addView(more, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 0, 6, 0, 0));
+            box.setOnClickListener(v -> {
+                final boolean open = body.getMaxLines() == 3;
+                body.setMaxLines(open ? Integer.MAX_VALUE : 3);
+                more.setText(LocaleController.getString(open ? R.string.HayoPluginLess : R.string.HayoPluginMore));
+            });
+            // короткое описание сворачивать нечего
+            body.post(() -> {
+                if (body.getLayout() != null && body.getLayout().getEllipsisCount(body.getLineCount() - 1) == 0 && body.getLineCount() <= 3) {
+                    more.setVisibility(View.GONE);
+                    box.setClickable(false);
+                }
+            });
+            root.addView(box, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 16, 0, 0));
+        }
+
+        // что плагин заявляет
+        final LinearLayout perms = card(context, card);
+        final TextView permsTitle = text(context, LocaleController.getString(R.string.HayoPluginAsks), 14, Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader));
+        permsTitle.setTypeface(AndroidUtilities.bold());
+        perms.addView(permsTitle);
+        if (plugin.permissions.isEmpty()) {
+            perms.addView(permission(context, R.drawable.hayo_ic_tune, LocaleController.getString(R.string.MargeletPluginPermNone), text));
+        } else {
+            for (String p : plugin.permissions) {
+                perms.addView(permission(context, permissionIcon(p), MargeletPlugins.permissionName(p), text));
+            }
+        }
+        if (plugin.usesHooks()) {
+            perms.addView(permission(context, R.drawable.hayo_ic_code, LocaleController.getString(R.string.HayoPluginHooks),
+                    Theme.getColor(Theme.key_text_RedRegular)));
+        }
+        root.addView(perms, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 12, 0, 0));
+
+        final TextView warn = text(context, LocaleController.getString(R.string.HayoPluginWarn), 13, gray);
+        root.addView(warn, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 4, 10, 4, 0));
+
+        // включить сразу (снято по умолчанию: плагин видишь впервые)
+        final boolean[] startNow = {false};
+        final LinearLayout startRow = new LinearLayout(context);
+        startRow.setOrientation(LinearLayout.HORIZONTAL);
+        startRow.setGravity(Gravity.CENTER_VERTICAL);
+        startRow.setPadding(dp(16), dp(14), dp(16), dp(14));
+        startRow.setBackground(Theme.createSimpleSelectorRoundRectDrawable(dp(16), card, Theme.getColor(Theme.key_listSelector)));
+        startRow.addView(text(context, LocaleController.getString(R.string.MargeletPluginEnableAfter), 16, text),
+                LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f));
+        final Switch sw = new Switch(context);
+        sw.setColors(Theme.key_switchTrack, Theme.key_switchTrackChecked, Theme.key_windowBackgroundWhite, Theme.key_windowBackgroundWhite);
+        startRow.addView(sw, LayoutHelper.createLinear(37, 20));
+        startRow.setOnClickListener(v -> {
+            startNow[0] = !startNow[0];
+            sw.setChecked(startNow[0], true);
+        });
+        root.addView(startRow, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 12, 0, 0));
+
+        // кнопки
+        final LinearLayout buttons = new LinearLayout(context);
+        buttons.setOrientation(LinearLayout.HORIZONTAL);
+        final TextView source = button(context, LocaleController.getString(R.string.HayoPluginCode),
+                HayoYou.on() ? HayoYou.secondaryContainer : card, HayoYou.on() ? HayoYou.onSecondaryContainer : text);
+        source.setOnClickListener(v -> actions.viewSource());
+        buttons.addView(source, LayoutHelper.createLinear(0, 48, 1f, 0, 0, 6, 0));
+        final TextView install = button(context, LocaleController.getString(existing != null
+                        ? R.string.MargeletPluginUpdateOk : R.string.MargeletPluginInstallOk),
+                Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_buttonText));
+        install.setOnClickListener(v -> {
+            done = true;
+            dismiss();
+            actions.install(startNow[0]);
+        });
+        buttons.addView(install, LayoutHelper.createLinear(0, 48, 1f, 6, 0, 0, 0));
+        root.addView(buttons, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, 0, 16, 0, 0));
+
+        final ScrollView scroll = new ScrollView(context);
+        scroll.addView(root);
+        setCustomView(scroll);
+        setOnDismissListener(d -> {
+            if (!done) {
+                actions.cancelled();
+            }
+        });
+    }
+
+    private static int permissionIcon(String key) {
+        switch (key) {
+            case "read_chats": return R.drawable.hayo_ic_chat_bubble;
+            case "send_messages": return R.drawable.hayo_ic_campaign;
+            case "edit_messages": return R.drawable.hayo_ic_format_paint;
+            case "delete_messages": return R.drawable.hayo_ic_visibility_off;
+            case "change_profile": return R.drawable.hayo_ic_account_circle;
+            case "ui": return R.drawable.hayo_ic_palette;
+        }
+        return R.drawable.hayo_ic_tune;
+    }
+
+    private static LinearLayout card(Context context, int color) {
+        final LinearLayout box = new LinearLayout(context);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(dp(16), dp(14), dp(16), dp(14));
+        box.setBackground(round(color, dp(16)));
+        return box;
+    }
+
+    private static View permission(Context context, int icon, CharSequence label, int color) {
+        final LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(0, dp(10), 0, 0);
+        final ImageView image = new ImageView(context);
+        image.setImageResource(icon);
+        image.setColorFilter(new PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN));
+        row.addView(image, LayoutHelper.createLinear(22, 22));
+        row.addView(text(context, label, 15, color), LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f, 14, 0, 0, 0));
+        return row;
+    }
+
+    private static TextView text(Context context, CharSequence value, int sp, int color) {
+        final TextView view = new TextView(context);
+        view.setText(value);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, sp);
+        view.setTextColor(color);
+        return view;
+    }
+
+    private static TextView button(Context context, CharSequence value, int bg, int fg) {
+        final TextView view = text(context, value, 15, fg);
+        view.setTypeface(AndroidUtilities.bold());
+        view.setGravity(Gravity.CENTER);
+        view.setSingleLine();
+        view.setEllipsize(TextUtils.TruncateAt.END);
+        view.setPadding(dp(12), 0, dp(12), 0);
+        view.setBackground(Theme.createSimpleSelectorRoundRectDrawable(dp(24), bg, Theme.multAlpha(fg, 0.15f)));
+        return view;
+    }
+
+    private static GradientDrawable round(int color, int radius) {
+        final GradientDrawable d = new GradientDrawable();
+        d.setColor(color);
+        d.setCornerRadius(radius);
+        return d;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoShapes.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoShapes.java
new file mode 100644
index 00000000..c730b55c
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/HayoShapes.java
@@ -0,0 +1,268 @@
+package org.telegram.margelet;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+import static org.telegram.messenger.AndroidUtilities.dpf2;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.os.Build;
+import android.os.SystemClock;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.HeaderCell;
+
+/**
+ * Формы Material 3: карточки секций, волнистая загрузка, углы листов и
+ * диалогов, кнопка действия. Всё смотрит на {@link HayoYou#on()}: выключили
+ * Material You, и форма телеграма возвращается как была.
+ */
+public class HayoShapes {
+
+    // ----------------------------------------------------------- секции
+
+    /** Отступ карточки секции от края экрана. */
+    public static int sectionPadding() {
+        return HayoYou.on() ? dp(16) : dp(12);
+    }
+
+    /** Внешние углы карточки секции: крупные, как в настройках андроида. */
+    public static float sectionRadius() {
+        return HayoYou.on() ? dp(24) : dp(16);
+    }
+
+    /**
+     * Заголовок секции (синий текст над группой строк). Под Material You он
+     * стоит над карточкой, а не внутри неё. Если строке кто-то дал свой фон,
+     * она остаётся в карточке: иначе вышел бы белый прямоугольник на сером.
+     */
+    public static boolean isSectionTitle(View view) {
+        if (!HayoYou.on() || !(view instanceof HeaderCell)
+                || ((HeaderCell) view).titleColorKey != Theme.key_windowBackgroundWhiteBlueHeader) {
+            return false;
+        }
+        android.graphics.drawable.Drawable bg = view.getBackground();
+        // универсальный список красит заголовку фон цветом карточки: это не «свой фон»
+        return bg == null || bg instanceof android.graphics.drawable.ColorDrawable
+                && ((android.graphics.drawable.ColorDrawable) bg).getColor() == Theme.getColor(Theme.key_windowBackgroundWhite);
+    }
+
+    private static final Paint dividerPaint = new Paint();
+    private static final java.util.ArrayList<View> dividerRows = new java.util.ArrayList<>();
+
+    /**
+     * Разделители MD3 внутри карточки: тонкая линия между соседними строками
+     * одной секции, от начала текста до края. Рисуются списком, поверх
+     * карточки и под строками, так что строкам самим ничего знать не надо.
+     */
+    public static void drawSectionDividers(androidx.recyclerview.widget.RecyclerView list, Canvas canvas, org.telegram.messenger.Utilities.CallbackReturn<View, Boolean> isSection) {
+        dividerRows.clear();
+        for (int i = 0; i < list.getChildCount(); i++) {
+            View child = list.getChildAt(i);
+            if (child.getVisibility() == View.VISIBLE && child.getAlpha() > 0 && list.getChildAdapterPosition(child) != androidx.recyclerview.widget.RecyclerView.NO_POSITION) {
+                dividerRows.add(child);
+            }
+        }
+        java.util.Collections.sort(dividerRows, (a, b) -> Integer.compare(list.getChildAdapterPosition(a), list.getChildAdapterPosition(b)));
+        HayoYou.ensureRoles();
+        dividerPaint.setColor(HayoYou.outlineVariant);
+        final float thick = Math.max(1f, dpf2(0.7f));
+        for (int i = 0; i + 1 < dividerRows.size(); i++) {
+            View a = dividerRows.get(i), b = dividerRows.get(i + 1);
+            if (list.getChildAdapterPosition(b) != list.getChildAdapterPosition(a) + 1) continue;
+            if (!isSection.run(a) || !isSection.run(b)) continue;
+            if (a instanceof HeaderCell || b instanceof HeaderCell) continue;
+            final float bottom = a.getY() + a.getHeight();
+            if (Math.abs(b.getY() - bottom) > dp(2)) continue;
+            // на всю ширину карточки: строки секции и есть её ширина
+            final float start = a.getX();
+            final float end = a.getX() + a.getWidth();
+            if (end - start < dp(24)) continue;
+            dividerPaint.setAlpha((int) (Color.alpha(HayoYou.outlineVariant) * Math.min(a.getAlpha(), b.getAlpha())));
+            canvas.drawRect(start, bottom - thick / 2f, end, bottom + thick / 2f, dividerPaint);
+        }
+        dividerRows.clear();
+    }
+
+    /** Где в строке начинается текст: с него и начинается разделитель. */
+    private static float textStart(View row) {
+        float found = findText(row, 0, 0);
+        return found < 0 ? dp(16) : found;
+    }
+
+    private static float findText(View v, float offset, int depth) {
+        if (depth > 0 && v.getVisibility() != View.VISIBLE) return -1;
+        if (depth > 0 && (v instanceof android.widget.TextView || v instanceof org.telegram.ui.ActionBar.SimpleTextView
+                || v instanceof org.telegram.ui.Components.AnimatedTextView)) {
+            return offset + v.getLeft() + v.getTranslationX() + v.getPaddingLeft();
+        }
+        if (v instanceof android.view.ViewGroup && depth < 3) {
+            android.view.ViewGroup g = (android.view.ViewGroup) v;
+            float best = -1;
+            float base = depth == 0 ? 0 : offset + v.getLeft() + v.getTranslationX();
+            for (int i = 0; i < g.getChildCount(); i++) {
+                float x = findText(g.getChildAt(i), base, depth + 1);
+                if (x >= 0 && (best < 0 || x < best)) best = x;
+            }
+            return best;
+        }
+        return -1;
+    }
+
+    // ----------------------------------------------------- волнистая дуга
+
+    private static final Path wave = new Path();
+
+    /**
+     * Замена canvas.drawArc для колец загрузки. Под Material You дуга идёт
+     * волной («червячок» MD3 Expressive), волна медленно бежит по кругу.
+     */
+    public static void arc(Canvas canvas, RectF oval, float startAngle, float sweepAngle, boolean useCenter, Paint paint) {
+        if (!HayoYou.on() || useCenter || paint.getStyle() == Paint.Style.FILL || Math.abs(sweepAngle) < 2f) {
+            canvas.drawArc(oval, startAngle, sweepAngle, useCenter, paint);
+            return;
+        }
+        final float r = Math.min(oval.width(), oval.height()) / 2f;
+        if (r < dp(4)) {
+            canvas.drawArc(oval, startAngle, sweepAngle, useCenter, paint);
+            return;
+        }
+        final float cx = oval.centerX(), cy = oval.centerY();
+        // высота волны растёт с кольцом, но не больше полутора dp и не меньше
+        // трети толщины линии, иначе на тонких кольцах её не видно
+        float amp = Math.min(dpf2(1.6f), r * 0.075f);
+        amp = Math.max(amp, Math.min(paint.getStrokeWidth() * 0.35f, dpf2(1.6f)));
+        final int waves = Math.max(5, Math.round((float) (2 * Math.PI * r / dp(11))));
+        final double phase = (SystemClock.uptimeMillis() % 3000L) / 3000.0 * 2 * Math.PI;
+        final float sweep = Math.min(Math.abs(sweepAngle), 360f) * Math.signum(sweepAngle);
+        final int steps = Math.max(12, (int) Math.ceil(Math.abs(sweep) / Math.max(1.2f, 360f / (waves * 10f))));
+        final float base = r - amp * 0.5f;
+        wave.rewind();
+        for (int i = 0; i <= steps; i++) {
+            final double a = Math.toRadians(startAngle + sweep * i / steps);
+            double rr = base + amp * Math.sin(waves * a + phase);
+            final float x = (float) (cx + rr * Math.cos(a));
+            final float y = (float) (cy + rr * Math.sin(a));
+            if (i == 0) {
+                wave.moveTo(x, y);
+            } else {
+                wave.lineTo(x, y);
+            }
+        }
+        final Paint.Join join = paint.getStrokeJoin();
+        paint.setStrokeJoin(Paint.Join.ROUND);
+        canvas.drawPath(wave, paint);
+        paint.setStrokeJoin(join);
+    }
+
+    // ------------------------------------------------- листы и диалоги
+
+    public static float dialogRadius(float telegram) {
+        return HayoYou.on() ? dp(28) : telegram;
+    }
+
+    /**
+     * Фон нижнего листа: верхние углы 28dp. Отступы как у картинки телеграма,
+     * чтобы раскладка листа не сдвинулась. Цвет задаётся через
+     * setColorFilter(цвет, MULTIPLY), как телеграм и делает с картинкой.
+     */
+    public static Drawable sheetBackground(Drawable telegram) {
+        if (!HayoYou.on() || telegram == null) {
+            return telegram;
+        }
+        Rect pad = new Rect();
+        telegram.getPadding(pad);
+        return new RoundDrawable(pad, dp(28), 0);
+    }
+
+    public static class RoundDrawable extends Drawable {
+        private final Rect padding;
+        private final float top, bottom;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path();
+        private final RectF rect = new RectF();
+        private final float[] radii = new float[8];
+
+        public RoundDrawable(Rect padding, float top, float bottom) {
+            this.padding = new Rect(padding);
+            this.top = top;
+            this.bottom = bottom;
+            paint.setColor(0xffffffff);
+            if (Build.VERSION.SDK_INT >= 28) {
+                paint.setShadowLayer(dpf2(3), 0, -dpf2(0.5f), 0x22000000);
+            }
+        }
+
+        @Override
+        public void draw(@NonNull Canvas canvas) {
+            Rect b = getBounds();
+            rect.set(b.left + padding.left, b.top + padding.top, b.right - padding.right, b.bottom - (bottom > 0 ? padding.bottom : 0));
+            radii[0] = radii[1] = radii[2] = radii[3] = top;
+            radii[4] = radii[5] = radii[6] = radii[7] = bottom;
+            path.rewind();
+            path.addRoundRect(rect, radii, Path.Direction.CW);
+            canvas.drawPath(path, paint);
+        }
+
+        @Override
+        public boolean getPadding(@NonNull Rect out) {
+            out.set(padding);
+            return true;
+        }
+
+        @Override
+        public void getOutline(@NonNull Outline outline) {
+            Rect b = getBounds();
+            outline.setRoundRect(b.left + padding.left, b.top + padding.top, b.right - padding.right, b.bottom, top);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            paint.setAlpha(alpha);
+            invalidateSelf();
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter colorFilter) {
+            paint.setColorFilter(colorFilter);
+            invalidateSelf();
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    // --------------------------------------------------- кнопка действия
+
+    /** Кнопка действия MD3: скруглённый квадрат, не круг. */
+    public static boolean fabSquircle() {
+        return HayoYou.on();
+    }
+
+    public static float fabRadius(int size) {
+        // 16dp у кнопки 56dp, пропорционально у других
+        return size * 16f / 56f;
+    }
+
+    public static final ViewOutlineProvider FAB_OUTLINE = new ViewOutlineProvider() {
+        @Override
+        public void getOutline(View view, Outline outline) {
+            int w = view.getWidth(), h = view.getHeight();
+            outline.setRoundRect(0, 0, w, h, fabRadius(Math.min(w, h)));
+        }
+    };
+}
