+                LocaleController.getString(org.telegram.margelet.MargeletHookEngine.brokeLastTime()
+                        ? R.string.HayoHooksBrokeShort : R.string.HayoPluginsMasterShort), on));
+        items.add(UItem.asShadow(null));
