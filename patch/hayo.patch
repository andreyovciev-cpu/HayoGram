+        out.add(section(LocaleController.getString(R.string.HayoForYou), HayoMusicOnline.available() && !recsLoading ? A_RECS : A_NONE));
+        if (recsLoading && !recsOnline()) {
+            out.add(new Row(T_RECS));
+        } else if (recsOnline()) {
+            out.add(new Row(T_RECS));
