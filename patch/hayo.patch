+    private void onClick(View view, int position, float x) {
+        if (reordering) return;
+        final HayoMusic.Track track = trackAt(position);
+        if (track == null) return;
+        if (x > HayoTrackCell.moreEdge(view)) {
+            showMenu(track, view);
+            return;
+        }
+        if (HayoTrackCell.inLike(view, x)) {
+            HayoMusicActions.like(track, message(track), null, () -> adapter.notifyDataSetChanged());
+            return;
+        }
+        if (HayoMusic.isPlaying(track.key()) && !org.telegram.messenger.MediaController.getInstance().isMessagePaused()) {
+            if (HayoPlayer.open(getParentActivity())) return;
+        }
+        play(position - 1, null);
+    }
