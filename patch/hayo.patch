+    private void loadRecsIfNeeded(boolean force) {
+        if (recsLoading) return;
+        if (!force && recs != null) return;
+        if (!HayoMusicOnline.available()) {
+            recs = null;
+            update();
+            return;
+        }
+        if (!force) {
+            final HayoMusicOnline.Result cached = HayoMusicOnline.cachedRecommendations();
+            if (cached != null) {
+                recs = cached;
+                update();
+                return;
+            }
+        }
+        recsLoading = true;
+        update();
+        HayoMusicOnline.recommendations(force, result -> {
+            recsLoading = false;
+            recs = result;
+            update();
+        });
+    }
