--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/MargeletWordmark.java
@@ -0,0 +1,84 @@
+package org.telegram.margelet;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+import android.text.TextPaint;
+
+import androidx.annotation.NonNull;
+
+import org.telegram.messenger.AndroidUtilities;
+
+/**
+ * Название форка, нарисованное текстом вместо картинки.
+ *
+ * На главном экране телеграм показывает имя двумя способами: развёрнутый
+ * заголовок — настоящей надписью, а свёрнутый — картинкой со словом
+ * «Telegram». Владелец это и заметил: имя менялось только когда развёрнуты
+ * истории. Картинку рисовать смысла нет, поэтому здесь просто текст,
+ * притворяющийся картинкой.
+ *
+ * Красится он белым, потому что поверх стоит цветовой фильтр умножением:
+ * белое умножается на цвет темы и становится этим цветом.
+ */
+public class MargeletWordmark extends Drawable {
+
+    private final TextPaint paint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final int height;
+
+    public MargeletWordmark() {
+        this(20);
+    }
+
+    /** Высота букв. На главном экране одна, на экране до входа крупнее. */
+    public MargeletWordmark(int heightDp) {
+        height = AndroidUtilities.dp(heightDp);
+        paint.setTypeface(AndroidUtilities.bold());
+        paint.setColor(0xFFFFFFFF);
+        paint.setTextSize(height);
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        final Rect b = getBounds();
+        paint.setTextSize(height);
+        float w = paint.measureText(MargeletConfig.APP_NAME);
+        if (w > b.width() && w > 0) {
+            paint.setTextSize(height * b.width() / w);
+            w = paint.measureText(MargeletConfig.APP_NAME);
+        }
+        final Paint.FontMetrics fm = paint.getFontMetrics();
+        canvas.drawText(MargeletConfig.APP_NAME, b.left,
+                b.centerY() - (fm.ascent + fm.descent) / 2f, paint);
+    }
+
+    @Override
+    public int getIntrinsicWidth() {
+        return (int) Math.ceil(paint.measureText(MargeletConfig.APP_NAME));
+    }
+
+    @Override
+    public int getIntrinsicHeight() {
+        return height;
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        paint.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+        paint.setColorFilter(colorFilter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoAvatars.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoAvatars.java
new file mode 100644
index 00000000..4f5d14e3
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/HayoAvatars.java
@@ -0,0 +1,141 @@
+package org.telegram.margelet;
+
+import android.graphics.Matrix;
+import android.graphics.Path;
+import android.graphics.RectF;
+
+/**
+ * Avatar shapes, the same ten as in HayoT: circle, rounded square, square, cookie, clover,
+ * burst, sun, pentagon, hexagon, heart. Every round avatar in the app (people and ordinary
+ * chats; forums keep their own rounded squares) is cut to the chosen one where
+ * ImageReceiver draws it.
+ */
+public final class HayoAvatars {
+
+    private HayoAvatars() {}
+
+    public static final String[] ALL = {"circle", "rounded", "square", "cookie", "clover", "burst", "sun",
+            "pentagon", "hexagon", "heart"};
+    private static final int POINTS = 144;
+    private static final Path[] UNIT = new Path[ALL.length];
+
+    private static int chosen = -1;
+
+    /** Set while an avatar is drawn in a shape: AvatarDrawable fills the whole square then. */
+    public static boolean drawing;
+
+    public static int chosen() {
+        if (chosen < 0) {
+            chosen = Math.max(0, Math.min(ALL.length - 1, MargeletConfig.prefs().getInt("avatar_shape", 0)));
+        }
+        return chosen;
+    }
+
+    public static void choose(int shape) {
+        chosen = Math.max(0, Math.min(ALL.length - 1, shape));
+        MargeletConfig.prefs().edit().putInt("avatar_shape", chosen).apply();
+    }
+
+    /** A shape other than the circle is chosen. */
+    public static boolean shaped() {
+        return chosen() != 0;
+    }
+
+    private static final Path placed = new Path();
+    private static final Matrix place = new Matrix();
+
+    /** The chosen shape filling this square, for a canvas to be clipped by. Main thread only. */
+    public static Path path(float x, float y, float w, float h) {
+        placed.rewind();
+        place.setScale(w / 2f, h / 2f);
+        place.postTranslate(x + w / 2f, y + h / 2f);
+        placed.addPath(unit(chosen()), place);
+        return placed;
+    }
+
+    /** A shape in a square two across, centred on nothing. Built once. */
+    public static Path unit(int shape) {
+        Path known = UNIT[shape];
+        if (known != null) return known;
+        Path made = new Path();
+        switch (ALL[shape]) {
+            case "rounded":
+                made.addRoundRect(new RectF(-1, -1, 1, 1), 0.44f, 0.44f, Path.Direction.CW);
+                break;
+            case "square":
+                made.addRect(-1, -1, 1, 1, Path.Direction.CW);
+                break;
+            case "heart":
+                made.arcTo(new RectF(-1f, -1f, 0.1f, 0.1f), -35.1f, -174.9f, true);
+                made.cubicTo(-0.70f, 0.25f, -0.28f, 0.70f, 0f, 1f);
+                made.cubicTo(0.28f, 0.70f, 0.70f, 0.25f, 0.926f, -0.175f);
+                made.arcTo(new RectF(-0.1f, -1f, 1f, 0.1f), 30f, -174.9f, false);
+                made.close();
+                break;
+            case "circle":
+                made.addCircle(0, 0, 1, Path.Direction.CW);
+                break;
+            default:
+                for (int i = 0; i < POINTS; i++) {
+                    double around = 2 * Math.PI * i / POINTS - Math.PI / 2;
+                    float reach = reach(ALL[shape], around + Math.PI / 2);
+                    float px = (float) (reach * Math.cos(around)), py = (float) (reach * Math.sin(around));
+                    if (i == 0) made.moveTo(px, py);
+                    else made.lineTo(px, py);
+                }
+                made.close();
+        }
+        UNIT[shape] = made;
+        return made;
+    }
+
+    private static float reach(String shape, double around) {
+        switch (shape) {
+            case "cookie": return 0.92f + 0.08f * (float) Math.cos(9 * around);
+            case "clover": return 0.84f + 0.16f * (float) Math.cos(4 * around + Math.PI);
+            case "burst": return 0.90f + 0.10f * (float) Math.cos(12 * around);
+            case "sun": return 0.87f + 0.13f * (float) Math.cos(8 * around);
+            case "pentagon": return sided(5, around);
+            case "hexagon": return sided(6, around);
+            default: return 1f;
+        }
+    }
+
+    private static float sided(int sides, double around) {
+        double slice = 2 * Math.PI / sides;
+        double within = around % slice;
+        if (within < 0) within += slice;
+        double flat = Math.cos(Math.PI / sides) / Math.cos(within - slice / 2);
+        double cap = 0.93, sharp = 36.0;
+        double soft = -Math.log(Math.exp(-sharp * flat) + Math.exp(-sharp * cap)) / sharp;
+        return (float) (soft / cap);
+    }
+
+    private static final Path ringPath = new Path();
+    private static final android.graphics.PathMeasure measure = new android.graphics.PathMeasure();
+
+    /** The story ring in the chosen shape, around `rect`. */
+    public static void ring(android.graphics.Canvas canvas, RectF rect, android.graphics.Paint paint) {
+        canvas.drawPath(path(rect.left, rect.top, rect.width(), rect.height()), paint);
+    }
+
+    /**
+     * A piece of the ring, by the angles Android's drawArc takes (0 at three o'clock, clockwise).
+     * The shapes start at twelve o'clock, so the angles are turned a quarter back.
+     */
+    public static void segment(android.graphics.Canvas canvas, RectF rect, android.graphics.Paint paint, float startAngle, float endAngle) {
+        Path whole = path(rect.left, rect.top, rect.width(), rect.height());
+        measure.setPath(whole, true);
+        float length = measure.getLength();
+        float from = (((startAngle + 90f) % 360f) + 360f) % 360f / 360f * length;
+        float sweep = Math.max(0f, Math.min(360f, endAngle - startAngle)) / 360f * length;
+        ringPath.rewind();
+        if (from + sweep <= length) {
+            measure.getSegment(from, from + sweep, ringPath, true);
+        } else {
+            measure.getSegment(from, length, ringPath, true);
+            measure.getSegment(0, from + sweep - length, ringPath, true);
+        }
+        canvas.drawPath(ringPath, paint);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoDeleted.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoDeleted.java
new file mode 100644
index 00000000..22d727a7
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/HayoDeleted.java
@@ -0,0 +1,181 @@
+package org.telegram.margelet;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import androidx.collection.LongSparseArray;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+
+/**
+ * Удалённые сообщения остаются, как в HayoT: когда собеседник удаляет
+ * сообщение, телеграм присылает это с сервера, а мы не стираем его ни с
+ * экрана, ни из базы, только запоминаем айди. В чате такое сообщение
+ * рисуется полупрозрачным.
+ *
+ * Свои удаления сюда не попадают: они идут своим путём, не через обновления
+ * с сервера, и работают как обычно.
+ *
+ * Айди в личках и обычных группах общие на аккаунт (ключ «u»), в каналах и
+ * супергруппах свои у каждого канала (ключ «c» + номер канала).
+ */
+public class HayoDeleted {
+
+    private static final int MOST_PER_KEY = 5000;
+    private static final HashMap<String, HashSet<Integer>> cache = new HashMap<>();
+
+    public static boolean enabled() {
+        return MargeletConfig.prefs().getBoolean("save_deleted", true);
+    }
+
+    public static void setEnabled(boolean on) {
+        MargeletConfig.prefs().edit().putBoolean("save_deleted", on).apply();
+    }
+
+    private static SharedPreferences store(int account) {
+        return ApplicationLoader.applicationContext.getSharedPreferences("hayo_deleted_" + account, Context.MODE_PRIVATE);
+    }
+
+    private static String key(long dialogKey) {
+        return dialogKey == 0 ? "u" : "c" + (-dialogKey);
+    }
+
+    private static HashSet<Integer> set(int account, String key) {
+        final String full = account + ":" + key;
+        synchronized (cache) {
+            HashSet<Integer> set = cache.get(full);
+            if (set == null) {
+                set = new HashSet<>();
+                final String saved = store(account).getString(key, "");
+                for (String part : saved.split(",")) {
+                    if (!part.isEmpty()) {
+                        try {
+                            set.add(Integer.parseInt(part));
+                        } catch (NumberFormatException ignored) {
+                        }
+                    }
+                }
+                cache.put(full, set);
+            }
+            return set;
+        }
+    }
+
+    /** Запомнить удалённое сервером. Ключ 0 — лички и группы, иначе -номер канала. */
+    public static void remember(int account, LongSparseArray<ArrayList<Integer>> deleted) {
+        final SharedPreferences.Editor editor = store(account).edit();
+        for (int i = 0; i < deleted.size(); i++) {
+            final String key = key(deleted.keyAt(i));
+            final HashSet<Integer> set = set(account, key);
+            synchronized (cache) {
+                set.addAll(deleted.valueAt(i));
+                final StringBuilder sb = new StringBuilder();
+                int n = 0;
+                for (Integer id : set) {
+                    if (n++ >= MOST_PER_KEY) break;
+                    if (sb.length() > 0) sb.append(',');
+                    sb.append(id);
+                }
+                editor.putString(key, sb.toString());
+            }
+        }
+        editor.apply();
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account)
+                .postNotificationName(NotificationCenter.hayoDeletedMessages));
+    }
+
+    public static boolean isDeleted(MessageObject message) {
+        if (message == null || message.messageOwner == null || message.getId() <= 0) {
+            return false;
+        }
+        final long channel = message.messageOwner.peer_id != null ? message.messageOwner.peer_id.channel_id : 0;
+        final HashSet<Integer> set = set(message.currentAccount, channel != 0 ? "c" + channel : "u");
+        synchronized (cache) {
+            return set.contains(message.getId());
+        }
+    }
+
+    private static final int QUOTE_MOST = 160;
+
+    /**
+     * Ответ на удалённое: телеграм такой ответ не примет (сообщения на сервере
+     * уже нет), поэтому вместо ответа ставим сверху цитату. В ней ник того, кому
+     * отвечаем, ссылкой-упоминанием, и его текст, длинный обрезаем.
+     */
+    public static void fakeReply(int account, SendMessagesHelper.SendMessageParams params) {
+        final MessageObject reply = params.replyToMsg;
+        if (reply == null || params.message == null || !enabled() || !isDeleted(reply)) {
+            return;
+        }
+        final MessagesController controller = MessagesController.getInstance(account);
+        final long from = reply.getFromChatId();
+        String name = null;
+        TLRPC.User user = null;
+        TLRPC.Chat chat = null;
+        if (from > 0) {
+            user = controller.getUser(from);
+            name = user != null ? UserObject.getUserName(user) : null;
+        } else if (from < 0) {
+            chat = controller.getChat(-from);
+            name = chat != null ? chat.title : null;
+        }
+        if (name == null || name.isEmpty()) {
+            name = "?";
+        }
+        String text = reply.messageOwner != null && reply.messageOwner.message != null && !reply.messageOwner.message.isEmpty()
+                ? reply.messageOwner.message : reply.messageText != null ? reply.messageText.toString() : "";
+        text = text.trim();
+        if (text.length() > QUOTE_MOST) {
+            int cut = QUOTE_MOST;
+            if (Character.isHighSurrogate(text.charAt(cut - 1))) cut--;
+            text = text.substring(0, cut).trim() + "…";
+        }
+        final String quote = text.isEmpty() ? name : name + "\n" + text;
+        final int shift = quote.length() + 1;
+
+        final java.util.ArrayList<TLRPC.MessageEntity> entities = new java.util.ArrayList<>();
+        final TLRPC.TL_messageEntityBlockquote block = new TLRPC.TL_messageEntityBlockquote();
+        block.offset = 0;
+        block.length = quote.length();
+        entities.add(block);
+        final TLRPC.TL_messageEntityBold bold = new TLRPC.TL_messageEntityBold();
+        bold.offset = 0;
+        bold.length = name.length();
+        entities.add(bold);
+        if (user != null) {
+            final TLRPC.TL_inputMessageEntityMentionName mention = new TLRPC.TL_inputMessageEntityMentionName();
+            mention.user_id = controller.getInputUser(user);
+            mention.offset = 0;
+            mention.length = name.length();
+            entities.add(mention);
+        } else if (chat != null && !android.text.TextUtils.isEmpty(chat.username)) {
+            final TLRPC.TL_messageEntityTextUrl link = new TLRPC.TL_messageEntityTextUrl();
+            link.url = "https://t.me/" + chat.username;
+            link.offset = 0;
+            link.length = name.length();
+            entities.add(link);
+        }
+        if (params.entities != null) {
+            for (TLRPC.MessageEntity e : params.entities) {
+                e.offset += shift;
+                entities.add(e);
+            }
+        }
+        params.message = quote + "\n" + params.message;
+        params.entities = entities;
+        // in a forum topic the message still goes to that topic: it replies to the topic's root,
+        // as a message written there without a reply does; with no reply at all it went to General
+        params.replyToMsg = params.replyToTopMsg;
+        params.replyQuote = null;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoEdits.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoEdits.java
new file mode 100644
index 00000000..b84b79cc
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/HayoEdits.java
@@ -0,0 +1,121 @@
+package org.telegram.margelet;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.tgnet.NativeByteBuffer;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * Edit history: when a message comes edited, what it said before is kept, so the message's
+ * menu can show every version. The earlier text is read from the app's own database just
+ * before the new one is written over it, on the same queue, so the order is certain.
+ *
+ * Only what this phone saw: a message that was never loaded here has no earlier version.
+ */
+public final class HayoEdits {
+
+    private HayoEdits() {}
+
+    private static final int MOST = 30;
+
+    public static boolean enabled() {
+        return MargeletConfig.prefs().getBoolean("edit_history", true);
+    }
+
+    public static void setEnabled(boolean on) {
+        MargeletConfig.prefs().edit().putBoolean("edit_history", on).apply();
+    }
+
+    private static SharedPreferences store(int account) {
+        return ApplicationLoader.applicationContext.getSharedPreferences("hayo_edits_" + account, Context.MODE_PRIVATE);
+    }
+
+    private static String key(long dialogId, int messageId) {
+        return dialogId + "_" + messageId;
+    }
+
+    /** Called with the edited messages before they are saved: their earlier text is kept first. */
+    public static void before(int account, long dialogId, ArrayList<MessageObject> edited) {
+        if (!enabled() || edited == null || edited.isEmpty()) return;
+        final ArrayList<TLRPC.Message> fresh = new ArrayList<>();
+        for (MessageObject one : edited) if (one != null && one.messageOwner != null) fresh.add(one.messageOwner);
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        storage.getStorageQueue().postRunnable(() -> {
+            for (TLRPC.Message now : fresh) {
+                SQLiteCursor cursor = null;
+                try {
+                    cursor = storage.getDatabase().queryFinalized("SELECT data FROM messages_v2 WHERE mid = " + now.id + " AND uid = " + dialogId);
+                    if (!cursor.next()) continue;
+                    NativeByteBuffer data = cursor.byteBufferValue(0);
+                    if (data == null) continue;
+                    TLRPC.Message was = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                    data.reuse();
+                    if (was == null) continue;
+                    String before = was.message == null ? "" : was.message;
+                    String after = now.message == null ? "" : now.message;
+                    if (before.equals(after)) continue;
+                    remember(account, dialogId, now.id, before, was.edit_date != 0 ? was.edit_date : was.date);
+                } catch (Throwable error) {
+                    FileLog.e(error);
+                } finally {
+                    if (cursor != null) cursor.dispose();
+                }
+            }
+        });
+    }
+
+    private static synchronized void remember(int account, long dialogId, int messageId, String text, int date) {
+        try {
+            SharedPreferences prefs = store(account);
+            JSONArray list = new JSONArray(prefs.getString(key(dialogId, messageId), "[]"));
+            if (list.length() > 0 && text.equals(list.getJSONObject(list.length() - 1).optString("text"))) return;
+            list.put(new JSONObject().put("text", text).put("date", date));
+            while (list.length() > MOST) list.remove(0);
+            prefs.edit().putString(key(dialogId, messageId), list.toString()).apply();
+        } catch (Throwable error) {
+            FileLog.e(error);
+        }
+    }
+
+    /** One version: what it said and since when (unix seconds). */
+    public static final class Version {
+        public final String text;
+        public final int date;
+
+        Version(String text, int date) {
+            this.text = text;
+            this.date = date;
+        }
+    }
+
+    /** The earlier versions of a message, oldest first. Empty when it was never seen edited. */
+    public static ArrayList<Version> history(MessageObject message) {
+        ArrayList<Version> out = new ArrayList<>();
+        if (message == null || message.messageOwner == null) return out;
+        try {
+            JSONArray list = new JSONArray(store(message.currentAccount).getString(key(message.getDialogId(), message.getId()), "[]"));
+            for (int i = 0; i < list.length(); i++) {
+                JSONObject one = list.getJSONObject(i);
+                out.add(new Version(one.optString("text"), one.optInt("date")));
+            }
+        } catch (Throwable error) {
+            FileLog.e(error);
+        }
+        return out;
+    }
+
+    public static boolean has(MessageObject message) {
+        return message != null && message.messageOwner != null && message.messageOwner.edit_date != 0
+                && store(message.currentAccount).contains(key(message.getDialogId(), message.getId()));
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoHelperBot.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoHelperBot.java
new file mode 100644
index 00000000..3cd3050a
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/margelet/HayoHelperBot.java
@@ -0,0 +1,372 @@
+package org.telegram.margelet;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.HashMap;
+
+/**
+ * Баннер и градиент профиля через бота Hayo Helper.
+ *
+ * Поставить или убрать: клиент тихо шлёт боту команду со своего аккаунта
+ * (баннер картинкой с подписью). Кто прислал, говорит сам телеграм, подделать
+ * это нельзя, поэтому баннер ставит только владелец аккаунта. Бот запоминает
+ * и сразу удаляет команду из переписки.
+ *
+ * Посмотреть: сервер форка отдаёт по айди телеграма что стоит
+ * (/api/gram/айди) и саму картинку (/api/gram/banner/айди).
+ *
+ * Своего сервера у сборки пока нет, поэтому адрес пуст и эти функции молчат:
+ * обращаться к серверу прошлого владельца мы не будем.
+ */
+public class HayoHelperBot {
+
+    public static final String USERNAME = "hayo_robot";
+    private static final String SITE = MargeletConfig.SERVER_URL;
+    /** Сколько помним чужой ответ, прежде чем спросить снова. */
+    private static final long FRESH = 10 * 60 * 1000L;
+
+    /** Что стоит у человека. banner — номер версии картинки, 0 — нет. */
+    public static final class Info {
+        public final long banner;
+        public final int[] gradient;
+        final long at;
+
+        Info(long banner, int[] gradient) {
+            this.banner = banner;
+            this.gradient = gradient;
+            this.at = System.currentTimeMillis();
+        }
+    }
+
+    public interface Got<T> {
+        void got(T value);
+    }
+
+    private static final HashMap<Long, Info> infos = new HashMap<>();
+    private static final HashMap<Long, java.util.ArrayList<Got<Info>>> asking = new HashMap<>();
+
+    /** Уже известное, без сети. Null — не спрашивали или устарело. */
+    public static Info known(long uid) {
+        synchronized (infos) {
+            final Info info = infos.get(uid);
+            return info != null && System.currentTimeMillis() - info.at < FRESH ? info : null;
+        }
+    }
+
+    /** Забыть, чтобы спросить заново. Своё свежее изменение не забывается. */
+    public static void forget(long uid) {
+        synchronized (infos) {
+            final Long until = pinnedUntil.get(uid);
+            if (until != null && until > System.currentTimeMillis()) {
+                return;
+            }
+            infos.remove(uid);
+        }
+    }
+
+    /** Спросить сервер в обход памяти: подтвердилось ли своё изменение. */
+    public static void recheck(long uid, Got<Info> done) {
+        synchronized (infos) {
+            final Info keep = infos.get(uid);
+            infos.remove(uid);
+            if (keep != null) {
+                pendingKeep.put(uid, keep);
+            }
+        }
+        info(uid, done);
+    }
+
+    private static final HashMap<Long, Info> pendingKeep = new HashMap<>();
+
+    /**
+     * Своё изменение держится, пока сервер не подтвердит то же самое (или
+     * минуту): иначе ответ, ушедший до того, как бот разобрал команду, вернул
+     * бы на экран старое.
+     */
+    private static final HashMap<Long, Long> pinnedUntil = new HashMap<>();
+
+    /** Положить своё сразу после изменения, не дожидаясь сервера. */
+    static void remember(long uid, long banner, int[] gradient) {
+        synchronized (infos) {
+            infos.put(uid, new Info(banner, gradient));
+            pinnedUntil.put(uid, System.currentTimeMillis() + 60_000L);
+        }
+    }
+
+    private static boolean same(Info a, Info b) {
+        if ((a.banner > 0) != (b.banner > 0)) return false;
+        if (a.gradient == null || b.gradient == null) return a.gradient == b.gradient;
+        return a.gradient[0] == b.gradient[0] && a.gradient[1] == b.gradient[1];
+    }
+
+    /** Спросить сервер, что стоит у человека. Ответ на главном потоке; при ошибке сети null. */
+    public static void info(long uid, Got<Info> done) {
+        final Info ready = known(uid);
+        if (ready != null) {
+            if (done != null) {
+                AndroidUtilities.runOnUIThread(() -> done.got(ready));
+            }
+            return;
+        }
+        synchronized (asking) {
+            java.util.ArrayList<Got<Info>> waiting = asking.get(uid);
+            if (waiting != null) {
+                if (done != null) waiting.add(done);
+                return;
+            }
+            waiting = new java.util.ArrayList<>();
+            if (done != null) waiting.add(done);
+            asking.put(uid, waiting);
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            Info info = null;
+            try {
+                final byte[] body = get(SITE + "/api/gram/" + uid);
+                if (body != null) {
+                    final JSONObject json = new JSONObject(new String(body, "UTF-8"));
+                    final JSONArray colors = json.optJSONArray("gradient");
+                    int[] gradient = null;
+                    if (colors != null && colors.length() >= 2) {
+                        gradient = new int[]{
+                                0xFF000000 | Integer.parseInt(colors.getString(0), 16),
+                                0xFF000000 | Integer.parseInt(colors.getString(1), 16)};
+                    }
+                    info = new Info(json.optLong("banner", 0), gradient);
+                    synchronized (infos) {
+                        Info kept = pendingKeep.remove(uid);
+                        if (kept == null) {
+                            kept = infos.get(uid);
+                        }
+                        final Long until = pinnedUntil.get(uid);
+                        if (kept != null && until != null && until > System.currentTimeMillis() && !same(kept, info)) {
+                            info = kept;   // сервер ещё не знает про свежее изменение
+                        } else {
+                            pinnedUntil.remove(uid);
+                        }
+                        infos.put(uid, info);
+                    }
+                }
+            } catch (Throwable t) {
+                FileLog.e(t);
+            }
+            final java.util.ArrayList<Got<Info>> waiting;
+            synchronized (asking) {
+                waiting = asking.remove(uid);
+            }
+            final Info result = info;
+            if (waiting != null) {
+                AndroidUtilities.runOnUIThread(() -> {
+                    for (Got<Info> one : waiting) {
+                        one.got(result);
+                    }
+                });
+            }
+        });
+    }
+
+    /** Картинка баннера этой версии. Кэшируется файлом, так что второй раз сеть не нужна. */
+    public static void banner(long uid, long version, Got<Bitmap> done) {
+        Utilities.globalQueue.postRunnable(() -> {
+            Bitmap bitmap = null;
+            try {
+                final java.io.File dir = new java.io.File(org.telegram.messenger.ApplicationLoader.applicationContext.getCacheDir(), "hayo_banners");
+                dir.mkdirs();
+                final java.io.File file = new java.io.File(dir, uid + "_" + version + ".jpg");
+                if (!file.exists()) {
+                    final byte[] body = get(SITE + "/api/gram/banner/" + uid + "?v=" + version);
+                    if (body != null) {
+                        try (java.io.FileOutputStream out = new java.io.FileOutputStream(file)) {
+                            out.write(body);
+                        }
+                    }
+                }
+                if (file.exists()) {
+                    final BitmapFactory.Options options = new BitmapFactory.Options();
+                    options.inSampleSize = 2;
+                    bitmap = BitmapFactory.decodeFile(file.getAbsolutePath(), options);
+                }
+            } catch (Throwable t) {
+                FileLog.e(t);
+            }
+            final Bitmap result = bitmap;
+            AndroidUtilities.runOnUIThread(() -> done.got(result));
+        });
+    }
+
+    private static byte[] get(String address) {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(address).openConnection();
+            connection.setConnectTimeout(10000);
+            connection.setReadTimeout(20000);
+            connection.setRequestProperty("User-Agent", "HayoGram/" + MargeletConfig.APP_VERSION);
+            if (connection.getResponseCode() != 200) {
+                return null;
+            }
+            try (InputStream in = connection.getInputStream()) {
+                final ByteArrayOutputStream out = new ByteArrayOutputStream();
+                final byte[] buffer = new byte[16384];
+                int read;
+                while ((read = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, read);
+                    if (out.size() > 8 * 1024 * 1024) {
+                        return null;
+                    }
+                }
+                return out.toByteArray();
+            }
+        } catch (Throwable t) {
+            return null;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    // ------------------------------------------------------------ команды боту
+
+    private static AccountInstance account() {
+        return AccountInstance.getInstance(UserConfig.selectedAccount);
+    }
+
+    private static long botId;
+
+    /** Айди бота: из памяти телеграма или спросив по юзернейму. */
+    private static void resolve(Got<Long> done) {
+        if (botId != 0) {
+            done.got(botId);
+            return;
+        }
+        account().getMessagesController().getUserNameResolver().resolve(USERNAME, id -> {
+            if (id != null && id > 0) {
+                botId = id;
+            }
+            done.got(id == null ? 0L : id);
+        });
+    }
+
+    /** Тихо отправить боту команду; с картинкой, если она есть. Ответ: ушло или нет. */
+    public static void send(String command, Uri picture, Got<Boolean> done) {
+        resolve(id -> {
+            if (id == null || id <= 0) {
+                if (done != null) done.got(false);
+                return;
+            }
+            try {
+                if (picture != null) {
+                    SendMessagesHelper.prepareSendingPhoto(account(), null, picture, id,
+                            null, null, null, command, null, null, null, 0,
+                            null, false, 0, 0, null);
+                } else {
+                    final SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(command, id);
+                    params.notify = false;
+                    account().getSendMessagesHelper().sendMessage(params);
+                }
+                if (done != null) done.got(true);
+            } catch (Throwable t) {
+                FileLog.e(t);
+                if (done != null) done.got(false);
+            }
+        });
+    }
+
+    // ------------------------------------------------------------ значок саппортера
+
+    /**
+     * Команды выдачи значков отключены: сервер и бот прежнего владельца в
+     * сборку не переезжают, а чужой аккаунт не должен раздавать значки.
+     */
+    public static final long OWNER = 0L;
+
+    /**
+     * «/give_badge ник или айди» в любом чате, с аккаунта владельца: значок
+     * саппортера уходит боту, а в чат вместо команды пишется, кто его получил.
+     * «/take_badge» снимает значок молча. Чужие такие сообщения уходят как есть.
+     * true — сообщение перехвачено и отправлять его не надо.
+     */
+    public static boolean giveBadge(int account, SendMessagesHelper.SendMessageParams params) {
+        if (OWNER <= 0 || params == null || params.message == null) {
+            return false;
+        }
+        final String text = params.message.trim();
+        final String low = text.toLowerCase();
+        final boolean give = low.startsWith("/give_badge");
+        final boolean take = low.startsWith("/take_badge");
+        if (!give && !take) {
+            return false;
+        }
+        if (UserConfig.getInstance(account).getClientUserId() != OWNER) {
+            return false;
+        }
+        final String[] parts = text.split("\\s+", 2);
+        if (parts.length < 2 || parts[1].trim().isEmpty()) {
+            return false;
+        }
+        final String who = parts[1].trim().replaceFirst("^@", "").replaceFirst("^https?://t\\.me/", "");
+        final Got<Long> withId = uid -> {
+            if (uid == null || uid <= 0) {
+                AndroidUtilities.runOnUIThread(() -> org.telegram.ui.Components.BulletinFactory.global()
+                        .createSimpleBulletin(org.telegram.messenger.R.raw.error,
+                                org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.HayoBadgeGiveFailed)).show());
+                return;
+            }
+            send((give ? "/gram_give " : "/gram_take ") + uid, null, ok -> {
+                if (!ok || !give) {
+                    return;
+                }
+                final org.telegram.tgnet.TLRPC.User user = AccountInstance.getInstance(account).getMessagesController().getUser(uid);
+                final String name = user != null && user.username != null && !user.username.isEmpty() ? "@" + user.username
+                        : user != null ? org.telegram.messenger.UserObject.getUserName(user) : String.valueOf(uid);
+                final SendMessagesHelper.SendMessageParams out = SendMessagesHelper.SendMessageParams.of(
+                        org.telegram.messenger.LocaleController.formatString(org.telegram.messenger.R.string.HayoBadgeGiven, name), params.peer);
+                out.replyToMsg = params.replyToMsg;
+                out.replyToTopMsg = params.replyToTopMsg;
+                AccountInstance.getInstance(account).getSendMessagesHelper().sendMessage(out);
+                // список значков подтянется с сервера заново
+                AndroidUtilities.runOnUIThread(MargeletBadge::refresh, 4000);
+            });
+        };
+        if (who.matches("\\d+")) {
+            withId.got(Long.parseLong(who));
+            return true;
+        }
+        // сначала те, кого приложение уже знает, потом запрос к серверу
+        final org.telegram.tgnet.TLObject known = AccountInstance.getInstance(account).getMessagesController().getUserOrChat(who);
+        if (known instanceof org.telegram.tgnet.TLRPC.User) {
+            withId.got(((org.telegram.tgnet.TLRPC.User) known).id);
+            return true;
+        }
+        final org.telegram.tgnet.TLRPC.TL_contacts_resolveUsername req = new org.telegram.tgnet.TLRPC.TL_contacts_resolveUsername();
+        req.username = who;
+        org.telegram.tgnet.ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+            if (response instanceof org.telegram.tgnet.TLRPC.TL_contacts_resolvedPeer) {
+                final org.telegram.tgnet.TLRPC.TL_contacts_resolvedPeer res = (org.telegram.tgnet.TLRPC.TL_contacts_resolvedPeer) response;
+                AccountInstance.getInstance(account).getMessagesController().putUsers(res.users, false);
+                AccountInstance.getInstance(account).getMessagesController().putChats(res.chats, false);
+                final long id = org.telegram.messenger.MessageObject.getPeerId(res.peer);
+                withId.got(id > 0 ? id : null);
+            } else {
+                org.telegram.ui.Components.BulletinFactory.global().createSimpleBulletin(org.telegram.messenger.R.raw.error,
+                        org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.HayoBadgeGiveFailed)
+                                + (error != null && error.text != null ? " (" + error.text + ")" : "")).show();
+            }
+        }));
+        return true;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/HayoLyrics.java b/TMessagesProj/src/main/java/org/telegram/margelet/HayoLyrics.java
