+++ b/TMessagesProj/src/main/java/org/telegram/ui/MargeletFontsActivity.java
@@ -0,0 +1,175 @@
+package org.telegram.ui;
+
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.OpenableColumns;
+import android.view.View;
+
+import org.telegram.margelet.MargeletFonts;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Ветка «Шрифт»: библиотека шрифтов и свои файлы.
+ *
+ * Смена шрифта требует перезапуска, и это не лень: шрифты уже разошлись по
+ * кэшам и по нарисованным экранам. Поэтому здесь сначала спрашивают, а потом
+ * приложение поднимается заново — с уже выбранным шрифтом.
+ */
+public class MargeletFontsActivity extends UniversalFragment {
+
+    private static final int ID_DEFAULT = 900;
+    private static final int ID_ADD = 901;
+    private static final int PICK_FONT = 4802;
+
+    /** Список на экране: по нему же находим шрифт по номеру строки. */
+    private List<MargeletFonts.Font> fonts = new ArrayList<>();
+
+    @Override
+    protected CharSequence getTitle() {
+        return LocaleController.getString(R.string.MargeletFonts);
+    }
+
+    @Override
+    public View createView(android.content.Context context) {
+        final View view = super.createView(context);
+        listView.setSections();
+        return view;
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        fonts = MargeletFonts.list();
+        final String chosen = MargeletFonts.chosen();
+        items.add(UItem.asHeader(LocaleController.getString(R.string.MargeletFontsHeader)));
+        items.add(UItem.asRadio(ID_DEFAULT, LocaleController.getString(R.string.MargeletFontsDefault))
+                .setChecked(chosen == null || chosen.isEmpty()));
+        for (int i = 0; i < fonts.size(); i++) {
+            final MargeletFonts.Font font = fonts.get(i);
+            items.add(UItem.asRadio(i, font.name).setChecked(font.id.equals(chosen)));
+        }
+        items.add(UItem.asShadow(LocaleController.getString(R.string.MargeletFontsAbout)));
+        items.add(UItem.asButton(ID_ADD, LocaleController.getString(R.string.MargeletFontsAdd)));
+        items.add(UItem.asShadow(LocaleController.getString(R.string.MargeletFontsAddAbout)));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_ADD) {
+            pick();
+            return;
+        }
+        if (item.id == ID_DEFAULT) {
+            confirm(MargeletFonts.DEFAULT);
+            return;
+        }
+        if (item.id >= 0 && item.id < fonts.size()) {
+            confirm(fonts.get(item.id).id);
+        }
+    }
+
+    /** Долгое нажатие по своему шрифту — убрать его из библиотеки. */
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        if (item.id < 0 || item.id >= fonts.size()) {
+            return false;
+        }
+        final MargeletFonts.Font font = fonts.get(item.id);
+        if (!font.own) {
+            return false;
+        }
+        new AlertDialog.Builder(getContext())
+                .setTitle(font.name)
+                .setMessage(LocaleController.getString(R.string.MargeletFontsRemoveAbout))
+                .setPositiveButton(LocaleController.getString(R.string.Delete), (d, w) -> {
+                    MargeletFonts.remove(font);
+                    listView.adapter.update(true);
+                })
+                .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                .show();
+        return true;
+    }
+
+    private void pick() {
+        // Шрифты приходят с самыми разными типами, а бывает, что и без типа.
+        // Поэтому спрашиваем любой файл, а годится он или нет — проверяем сами
+        // после копирования.
+        final Intent intent = new Intent(Intent.ACTION_GET_CONTENT);
+        intent.setType("*/*");
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        try {
+            startActivityForResult(intent, PICK_FONT);
+        } catch (Exception ignored) {
+            // Не на каждом телефоне есть чем открыть выбор файла.
+        }
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != PICK_FONT || data == null || data.getData() == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        final String installed = MargeletFonts.install(uri, name(uri));
+        if (installed == null) {
+            BulletinFactory.of(this).createErrorBulletin(
+                    LocaleController.getString(R.string.MargeletFontsBad)).show();
+            return;
+        }
+        listView.adapter.update(true);
+        confirm(installed);
+    }
+
+    /** Как файл называется у человека — чтобы в списке было узнаваемо. */
+    private String name(Uri uri) {
+        try (Cursor cursor = ApplicationLoader.applicationContext.getContentResolver()
+                .query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                final int column = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (column >= 0) {
+                    return cursor.getString(column);
+                }
+            }
+        } catch (Exception ignored) {
+        }
+        return uri.getLastPathSegment();
+    }
+
+    /** Выбор вступает в силу только после перезапуска, и об этом спрашивают. */
+    private void confirm(String id) {
+        new AlertDialog.Builder(getContext())
+                .setTitle(LocaleController.getString(R.string.MargeletFonts))
+                .setMessage(LocaleController.getString(R.string.MargeletFontsRestart))
+                .setPositiveButton(LocaleController.getString(R.string.MargeletFontsRestartNow), (d, w) -> {
+                    MargeletFonts.choose(id);
+                    MargeletFonts.restart(getParentActivity());
+                })
+                .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                .show();
+    }
+
+    // Как экраны самого телеграма: рисуемся под полоской жестов, а список
+    // получает снизу отступ на её высоту, вместо пустой полосы под ним.
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+
+    @Override
+    public void onInsets(int left, int top, int right, int bottom) {
+        if (listView != null) {
+            listView.setPadding(listView.getPaddingLeft(), listView.getPaddingTop(), listView.getPaddingRight(), bottom);
+            listView.setClipToPadding(false);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/MargeletMarkupActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/MargeletMarkupActivity.java
new file mode 100644
index 00000000..9794b346
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/MargeletMarkupActivity.java
@@ -0,0 +1,277 @@
+package org.telegram.ui;
+
+import android.view.View;
+
+import org.telegram.margelet.MargeletConfig;
+import org.telegram.margelet.MargeletMarkup;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+/**
+ * Категория «Сообщения»: своё оформление в чужих сообщениях, разметка
+ * значками при отправке, поле ввода и мелочи про свои сообщения. Раньше это
+ * были три вложенных экрана; теперь всё на одном, разделено заголовками.
+ *
+ * Выключатели оформления не про отправку, а про показ: отправить оформленное
+ * можно всегда, а вот принимать чужую радугу человек может и не хотеть.
+ */
+public class MargeletMarkupActivity extends UniversalFragment {
+
+    private static final int ID_SIZE = 1;
+    private static final int ID_DIM = 2;
+    private static final int ID_RAINBOW = 3;
+    private static final int ID_OUTLINE = 4;
+    private static final int ID_BUTTON = 5;
+    private static final int ID_EMOJI = 6;
+    private static final int ID_COPY = 7;
+    private static final int ID_BUBBLES = 8;
+    private static final int ID_TOP = 9;
+    private static final int ID_MARKDOWN = 100;
+    private static final int[] STICKER_SIZES = {50, 60, 70, 80, 90, 100, 115, 130, 150};
+
+    private static final String[] KINDS = {
+            "bold", "italic", "underline", "strike", "spoiler", "code", "quote", "quote_collapsed"
+    };
+    private static final int[] TITLES = {
+            R.string.Bold, R.string.Italic, R.string.Underline, R.string.Strike,
+            R.string.Spoiler, R.string.Mono, R.string.MargeletMarkdownQuote,
+            R.string.MargeletMarkdownQuoteCollapsed
+    };
+    private static final String[] SAMPLES = {
+            "**…**", "__…__", "++…++", "~~…~~", "||…||", "`…`", ">…", ">>…"
+    };
+
+    /** Высота поля в строках, 0 — «расти, пока есть место». */
+    private static final int[] LINES = {2, 3, 4, 5, 6, 8, 10, 15, 0};
+    private static final int[] SIZES = {14, 15, 16, 17, 18, 19, 20, 22, 24};
+
+
+    @Override
+    protected CharSequence getTitle() {
+        return LocaleController.getString(R.string.HayoSecMessages);
+    }
+
+    @Override
+    public View createView(android.content.Context context) {
+        markupChat = null;
+        inputChat = null;
+        stickerChat = null;
+        final View view = super.createView(context);
+        listView.setSections();
+        return view;
+    }
+
+    private static String s(int res) {
+        return LocaleController.getString(res);
+    }
+
+    private static int indexOf(int[] arr, int value, int fallback) {
+        for (int i = 0; i < arr.length; i++) {
+            if (arr[i] == value) {
+                return i;
+            }
+        }
+        return fallback;
+    }
+
+    private HayoChatPreview markupChat;
+    private HayoChatPreview inputChat;
+    private HayoChatPreview stickerChat;
+
+    /**
+     * Стикер для витрины: толстый тилкайо из файлов приложения. Документ
+     * ненастоящий, картинка лежит там, где телеграм ищет скачанное, поэтому
+     * в сеть за ней никто не идёт.
+     */
+    private org.telegram.tgnet.TLRPC.Document previewSticker() {
+        try {
+            final org.telegram.tgnet.TLRPC.TL_document doc = new org.telegram.tgnet.TLRPC.TL_document();
+            doc.id = 0x4D61726779546CL;
+            doc.dc_id = 2;
+            doc.access_hash = 0;
+            doc.file_reference = new byte[0];
+            doc.mime_type = "image/webp";
+            doc.date = (int) (System.currentTimeMillis() / 1000);
+            final org.telegram.tgnet.TLRPC.TL_documentAttributeImageSize size = new org.telegram.tgnet.TLRPC.TL_documentAttributeImageSize();
+            size.w = size.h = 512;
+            doc.attributes.add(size);
+            final org.telegram.tgnet.TLRPC.TL_documentAttributeSticker sticker = new org.telegram.tgnet.TLRPC.TL_documentAttributeSticker();
+            sticker.alt = "\uD83D\uDC31";
+            sticker.stickerset = new org.telegram.tgnet.TLRPC.TL_inputStickerSetEmpty();
+            doc.attributes.add(sticker);
+            final java.io.File file = org.telegram.messenger.FileLoader.getInstance(currentAccount).getPathToAttach(doc, true);
+            if (!file.exists() || file.length() == 0) {
+                file.getParentFile().mkdirs();
+                try (java.io.InputStream in = getContext().getAssets().open("hayo_tilcayo.webp");
+                     java.io.OutputStream out = new java.io.FileOutputStream(file)) {
+                    final byte[] buf = new byte[16384];
+                    int n;
+                    while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+                }
+            }
+            doc.size = file.length();
+            doc.localPath = file.getAbsolutePath();
+            return doc;
+        } catch (Exception e) {
+            org.telegram.messenger.FileLog.e(e);
+            return null;
+        }
+    }
+
+    private void redraw() {
+        if (markupChat != null) {
+            markupChat.refresh();
+        }
+        if (inputChat != null) {
+            inputChat.refresh();
+        }
+        if (stickerChat != null) {
+            stickerChat.refresh();
+        }
+    }
+
+    /** Сообщение со всеми видами своего оформления: какие включены, те и видны. */
+    private static String markupSample() {
+        final StringBuilder sb = new StringBuilder();
+        sb.append(MargeletMarkup.open(MargeletMarkup.KIND_RAINBOW, 0)).append(s(R.string.MargeletMarkupRainbow)).append(MargeletMarkup.close()).append(", ");
+        sb.append(MargeletMarkup.open(MargeletMarkup.KIND_OUTLINE, 0)).append(s(R.string.MargeletMarkupOutline).toLowerCase()).append(MargeletMarkup.close()).append(", ");
+        sb.append(MargeletMarkup.open(MargeletMarkup.KIND_SIZE, MargeletMarkup.sizeValue(1.6f))).append(s(R.string.MargeletMarkupSize).toLowerCase()).append(MargeletMarkup.close()).append(" ");
+        sb.append(s(R.string.HayoPreviewAnd)).append(" ");
+        sb.append(MargeletMarkup.open(MargeletMarkup.KIND_DIM, 7)).append(s(R.string.MargeletMarkupDim).toLowerCase()).append(MargeletMarkup.close());
+        return sb.toString();
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        // своё оформление в чужих сообщениях
+        items.add(UItem.asHeader(s(R.string.HayoMarkupShowHeader)));
+        if (markupChat == null && getContext() != null) {
+            markupChat = new HayoChatPreview(getContext(), false, new HayoChatPreview.Message(markupSample(), false));
+        }
+        if (markupChat != null) {
+            items.add(UItem.asCustom(markupChat));
+        }
+        items.add(UItem.asCheck(ID_RAINBOW, s(R.string.MargeletMarkupRainbow)).setChecked(MargeletConfig.markupEnabled(MargeletMarkup.KIND_RAINBOW)));
+        items.add(UItem.asCheck(ID_OUTLINE, s(R.string.MargeletMarkupOutline)).setChecked(MargeletConfig.markupEnabled(MargeletMarkup.KIND_OUTLINE)));
+        items.add(UItem.asCheck(ID_SIZE, s(R.string.MargeletMarkupSize)).setChecked(MargeletConfig.markupEnabled(MargeletMarkup.KIND_SIZE)));
+        items.add(UItem.asCheck(ID_DIM, s(R.string.MargeletMarkupDim)).setChecked(MargeletConfig.markupEnabled(MargeletMarkup.KIND_DIM)));
+        items.add(HayoRowCell.Factory.check(ID_EMOJI, R.drawable.hayo_ic_looks, s(R.string.MargeletFreeEmoji),
+                s(R.string.MargeletFreeEmojiAbout), MargeletConfig.freeEmoji()));
+        items.add(UItem.asShadow(null));
+
+        // разметка значками при отправке
+        items.add(UItem.asHeader(s(R.string.MargeletMarkdown)));
+        for (int i = 0; i < KINDS.length; i++) {
+            items.add(UItem.asCheck(ID_MARKDOWN + i, s(TITLES[i]) + "   " + SAMPLES[i])
+                    .setChecked(MargeletConfig.markdownEnabled(KINDS[i])));
+        }
+        items.add(UItem.asShadow(null));
+
+        // поле ввода
+        items.add(UItem.asHeader(s(R.string.MargeletInput)));
+        if (inputChat == null && getContext() != null) {
+            inputChat = new HayoChatPreview(getContext(), true,
+                    new HayoChatPreview.Message(s(R.string.HayoPreviewIn), false));
+        }
+        if (inputChat != null) {
+            items.add(UItem.asCustom(inputChat));
+        }
+        items.add(UItem.asCheck(ID_TOP, s(R.string.MargeletInputOnTop)).setChecked(MargeletConfig.inputOnTop()));
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asHeader(s(R.string.MargeletLines)));
+        final String[] lines = new String[LINES.length];
+        for (int i = 0; i < LINES.length; i++) {
+            lines[i] = LINES[i] == 0 ? s(R.string.MargeletLinesMax) : String.valueOf(LINES[i]);
+        }
+        items.add(UItem.asSlideView(lines, indexOf(LINES, MargeletConfig.inputMaxLinesRaw(), 4),
+                i -> { MargeletConfig.setInputMaxLines(LINES[i]); redraw(); }));
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asHeader(s(R.string.MargeletTextSize)));
+        final String[] sizes = new String[SIZES.length];
+        for (int i = 0; i < SIZES.length; i++) {
+            sizes[i] = String.valueOf(SIZES[i]);
+        }
+        items.add(UItem.asSlideView(sizes, indexOf(SIZES, Math.round(MargeletConfig.inputTextSize()), 4),
+                i -> { MargeletConfig.setInputTextSize(SIZES[i]); redraw(); }));
+        items.add(UItem.asShadow(null));
+
+        // стикеры: размер и форма
+        items.add(UItem.asHeader(s(R.string.HayoStickers)));
+        if (stickerChat == null && getContext() != null) {
+            final org.telegram.tgnet.TLRPC.Document sticker = previewSticker();
+            if (sticker != null) {
+                stickerChat = new HayoChatPreview(getContext(), false, new HayoChatPreview.Message(sticker, false));
+            }
+        }
+        if (stickerChat != null) {
+            items.add(UItem.asCustom(stickerChat));
+        }
+        final String[] stickerSizes = new String[STICKER_SIZES.length];
+        for (int i = 0; i < STICKER_SIZES.length; i++) {
+            stickerSizes[i] = STICKER_SIZES[i] + "%";
+        }
+        items.add(UItem.asSlideView(stickerSizes, indexOf(STICKER_SIZES, MargeletConfig.stickerSize(), 5),
+                i -> { MargeletConfig.setStickerSize(STICKER_SIZES[i]); redraw(); }));
+        items.add(UItem.asHeader(s(R.string.HayoStickerRound)));
+        items.add(UItem.asIntSlideView(1, 0, MargeletConfig.stickerRound(), 50,
+                v -> v == 0 ? s(R.string.HayoStickerShapeAsIs) : v == 50 ? s(R.string.HayoStickerShapeCircle) : v + "%",
+                v -> { MargeletConfig.setStickerRound(v); if (stickerChat != null) stickerChat.invalidateAll(); }));
+        items.add(UItem.asShadow(null));
+
+        // свои сообщения
+        items.add(HayoRowCell.Factory.check(ID_COPY, R.drawable.hayo_ic_tune, s(R.string.MargeletCopyFormatted),
+                s(R.string.HayoCopyShort), MargeletConfig.copyFormatting()));
+        items.add(UItem.asShadow(null));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        final int id = item.id;
+        if (id >= ID_MARKDOWN && id < ID_MARKDOWN + KINDS.length) {
+            final String kind = KINDS[id - ID_MARKDOWN];
+            MargeletConfig.setMarkdownEnabled(kind, !MargeletConfig.markdownEnabled(kind));
+        } else if (id == ID_COPY) {
+            MargeletConfig.setCopyFormatting(!MargeletConfig.copyFormatting());
+        } else if (id == ID_EMOJI) {
+            MargeletConfig.setFreeEmoji(!MargeletConfig.freeEmoji());
+        } else if (id == ID_TOP) {
+            MargeletConfig.setInputOnTop(!MargeletConfig.inputOnTop());
+        } else if (id == ID_SIZE || id == ID_DIM || id == ID_RAINBOW || id == ID_OUTLINE || id == ID_BUTTON) {
+            final int kind = id == ID_SIZE ? MargeletMarkup.KIND_SIZE
+                    : id == ID_DIM ? MargeletMarkup.KIND_DIM
+                    : id == ID_OUTLINE ? MargeletMarkup.KIND_OUTLINE
+                    : id == ID_BUTTON ? MargeletMarkup.KIND_BUTTON
+                    : MargeletMarkup.KIND_RAINBOW;
+            MargeletConfig.setMarkupEnabled(kind, !MargeletConfig.markupEnabled(kind));
+        } else {
+            return;
+        }
+        listView.adapter.update(true);
+        redraw();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+
+    // Как экраны самого телеграма: рисуемся под полоской жестов, а список
+    // получает снизу отступ на её высоту, вместо пустой полосы под ним.
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+
+    @Override
+    public void onInsets(int left, int top, int right, int bottom) {
+        if (listView != null) {
+            listView.setPadding(listView.getPaddingLeft(), listView.getPaddingTop(), listView.getPaddingRight(), bottom);
+            listView.setClipToPadding(false);
+        }
+    }
+}
