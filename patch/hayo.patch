+                .setMessage(s(R.string.MargeletSeizureWarningText))
+                .setPositiveButton(s(R.string.MargeletSeizureEnable), (d, w) -> {
+                    MargeletSeizure.set(true);
+                    toggled(view, true);
+                })
+                .setNegativeButton(s(R.string.Cancel), null)
+                .show();
+    }
