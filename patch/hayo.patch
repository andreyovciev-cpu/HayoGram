+        } catch (Throwable error) {
+            FileLog.e(error);
+            return null;
+        } finally {
+            if (in != null) in.cleanup();
+        }
+    }
+
+    /** Можно ли положить сообщение в плейлист: песня из обычного чата или из сети. */
