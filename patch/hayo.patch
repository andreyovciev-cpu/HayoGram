+
+/**
+ * 3D-тилкайо, питомец серии. Общий договор двух частей: экран питомца
+ * (HayoPetSheet) только создаёт этот вид и зовёт методы ниже, а как он
+ * рисует, решает сам вид. Сигнатуры не менять.
+ *
+ * Внутри TextureView с прозрачным фоном и свой GL-поток (HayoPetRenderer),
+ * модель строится из фигур в HayoPetMesh, шейдеры в HayoPetShaders.
+ */
+public class HayoPetView extends FrameLayout {
+
+    public static final int STAGE_EGG = 0;
+    public static final int STAGE_HATCHING = 1;
+    public static final int STAGE_BABY = 2;
+    public static final int STAGE_ADULT = 3;
+
+    private final TextureView texture;
+    private final HayoPetRenderer renderer;
+    private boolean resumed = true;
+
+    // жест
+    private final int touchSlop;
+    private float downX, downY, lastX, lastY;
+    private long downTime;
+    private boolean dragging;
+    private VelocityTracker velocity;
+
+    public HayoPetView(Context context) {
+        super(context);
+        renderer = new HayoPetRenderer(context.getResources().getDisplayMetrics().density);
+        touchSlop = ViewConfiguration.get(context).getScaledTouchSlop();
