+++ b/TMessagesProj/src/main/java/org/telegram/ui/HayoShapePicker.java
@@ -0,0 +1,90 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.telegram.margelet.HayoAvatars;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.LayoutHelper;
+
+/**
+ * The avatar shapes, as in HayoT: a row of them under a heading, the chosen one filled with
+ * the accent and the rest quiet. A tap changes every avatar in the app at once.
+ */
+@SuppressLint("ViewConstructor")
+public class HayoShapePicker extends LinearLayout {
+
+    private static final int[] NAMES = {R.string.HayoShapeCircle, R.string.HayoShapeRounded, R.string.HayoShapeSquare,
+            R.string.HayoShapeCookie, R.string.HayoShapeClover, R.string.HayoShapeBurst, R.string.HayoShapeSun,
+            R.string.HayoShapePentagon, R.string.HayoShapeHexagon, R.string.HayoShapeHeart};
+
+    private static int scrolled;
+
+    public HayoShapePicker(Context context, Runnable picked) {
+        super(context);
+        setOrientation(VERTICAL);
+        final TextView title = new TextView(context);
+        title.setText(LocaleController.getString(R.string.HayoAvatarShape));
+        title.setTextSize(16);
+        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        title.setPadding(dp(20), dp(14), dp(20), 0);
+        addView(title);
+        final HorizontalScrollView scroll = new HorizontalScrollView(context) {
+            @Override
+            protected void onScrollChanged(int l, int t, int oldl, int oldt) {
+                super.onScrollChanged(l, t, oldl, oldt);
+                scrolled = l;
+            }
+        };
+        scroll.setHorizontalScrollBarEnabled(false);
+        final LinearLayout row = new LinearLayout(context);
+        row.setPadding(dp(12), dp(8), dp(12), dp(12));
+        for (int i = 0; i < HayoAvatars.ALL.length; i++) {
+            final int shape = i;
+            final View tile = new View(context) {
+                final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+                final Path path = new Path();
+                final Matrix place = new Matrix();
+
+                @Override
+                protected void onDraw(Canvas canvas) {
+                    boolean on = HayoAvatars.chosen() == shape;
+                    float side = Math.min(getWidth(), getHeight()) - dp(on ? 8 : 12);
+                    path.rewind();
+                    place.setScale(side / 2f, side / 2f);
+                    place.postTranslate(getWidth() / 2f, getHeight() / 2f);
+                    path.addPath(HayoAvatars.unit(shape), place);
+                    paint.setStyle(Paint.Style.FILL);
+                    paint.setColor(on ? Theme.getColor(Theme.key_featuredStickers_addButton)
+                            : Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon) & 0x66FFFFFF);
+                    canvas.drawPath(path, paint);
+                }
+            };
+            tile.setContentDescription(LocaleController.getString(NAMES[i]));
+            tile.setOnClickListener(v -> {
+                if (HayoAvatars.chosen() == shape) return;
+                HayoAvatars.choose(shape);
+                row.invalidate();
+                for (int k = 0; k < row.getChildCount(); k++) row.getChildAt(k).invalidate();
+                if (picked != null) picked.run();
+            });
+            row.addView(tile, LayoutHelper.createLinear(56, 56, Gravity.CENTER_VERTICAL, 4, 0, 4, 0));
+        }
+        scroll.addView(row);
+        addView(scroll);
+        scroll.post(() -> scroll.scrollTo(scrolled, 0));
+    }
+}
