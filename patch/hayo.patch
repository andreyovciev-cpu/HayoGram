+
+    // --- вкладка «свои» ---
+
+    private void fillMine(ArrayList<UItem> items, UniversalAdapter adapter) {
+        plugins = MargeletPlugins.installed();
+
+        // Один выключатель на всё: плагины без хуков почти ничего не умеют,
