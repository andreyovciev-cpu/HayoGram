+    public static void show(Context context, MessageObject message, BulletinFactory bulletins) {
+        if (context == null || !HayoMusic.canAdd(message)) return;
+        final ArrayList<HayoMusic.Playlist> lists = HayoMusic.playlists();
+        final CharSequence[] names = new CharSequence[lists.size() + 1];
+        final int[] icons = new int[lists.size() + 1];
+        for (int i = 0; i < lists.size(); i++) {
+            names[i] = lists.get(i).name;
+            icons[i] = R.drawable.hayo_ic_queue_music;
+        }
+        names[lists.size()] = LocaleController.getString(R.string.HayoPlaylistNew);
+        icons[lists.size()] = R.drawable.hayo_ic_add;
+        final BottomSheet.Builder builder = new BottomSheet.Builder(context);
+        builder.setTitle(LocaleController.getString(R.string.HayoAddToPlaylist));
+        builder.setItems(names, icons, (dialog, which) -> {
+            if (which < lists.size()) {
+                put(context, lists.get(which), message, bulletins);
+            } else {
+                askName(context, LocaleController.getString(R.string.HayoPlaylistNew), "", name ->
+                        put(context, HayoMusic.create(name), message, bulletins));
+            }
+        });
+        builder.show();
+    }
+
+    private static void put(Context context, HayoMusic.Playlist playlist, MessageObject message, BulletinFactory bulletins) {
+        final boolean added = HayoMusic.add(playlist, message);
+        final String text = LocaleController.formatString(added ? R.string.HayoPlaylistAdded : R.string.HayoPlaylistAlready, playlist.name);
+        if (bulletins != null) {
+            bulletins.createSimpleBulletin(added ? R.raw.contact_check : R.raw.chats_infotip, text).show();
+        } else {
+            Toast.makeText(context, text, Toast.LENGTH_SHORT).show();
+        }
+    }
