+         * каждый раз незачем.
+         */
+        public Bitmap icon() {
+            if (!iconRead) {
+                iconRead = true;
+                final File file = new File(folder, "icon.png");
+                if (file.exists()) {
+                    icon = BitmapFactory.decodeFile(file.getAbsolutePath());
+                }
+            }
+            return icon;
