+    private HayoMusicTiles.Shelf recsShelf(Context context) {
+        if (recsShelf != null) return recsShelf;
+        recsShelf = new HayoMusicTiles.Shelf(context, new HayoMusicTiles.Shelf.Binder() {
+            @Override
+            public int count() {
+                if (recsOnline()) return recs.items.size();
+                if (recsLoading) return 4;
+                return recsFromChats.size();
+            }
+
+            @Override
+            public View create(Context context) {
+                return new HayoMusicTiles.TrackTile(context, 132);
+            }
+
+            @Override
+            public void bind(View view, int position) {
+                final HayoMusicTiles.TrackTile tile = (HayoMusicTiles.TrackTile) view;
+                if (recsOnline()) {
+                    final HayoMusic.Track track = recs.items.get(position);
+                    tile.set(track, HayoMusic.isPlaying(track.key()), HayoMusicOnline.progress(track.key()));
+                } else if (recsLoading) {
+                    tile.setLoading();
+                } else if (position < recsFromChats.size()) {
+                    final MessageObject message = recsFromChats.get(position);
+                    tile.set(message, HayoMusic.isPlaying(HayoMusic.keyOf(message)));
+                }
+            }
+        });
+        recsShelf.setOnItemClickListener((view, position) -> {
+            if (recsOnline()) {
+                if (position >= recs.items.size()) return;
+                if (openPlayerIfCurrent(recs.items.get(position).key())) return;
+                HayoMusic.play(new ArrayList<>(recs.items), position, null, LocaleController.getString(R.string.HayoForYou));
+            } else if (!recsLoading && position < recsFromChats.size()) {
+                if (openPlayerIfCurrent(HayoMusic.keyOf(recsFromChats.get(position)))) return;
+                HayoMusic.playMessages(new ArrayList<>(recsFromChats), position, LocaleController.getString(R.string.HayoForYou));
+            }
+        });
+        recsShelf.setOnItemLongClickListener((view, position) -> {
+            if (recsOnline() && position < recs.items.size()) {
+                HayoMusicActions.menu(host.fragment(), view, recs.items.get(position), null, host.bulletins(), null, this::update);
+                return true;
+            } else if (!recsLoading && position < recsFromChats.size()) {
+                HayoMusicActions.menu(host.fragment(), view, null, recsFromChats.get(position), host.bulletins(), null, this::update);
+                return true;
+            }
+            return false;
+        });
+        return recsShelf;
+    }
