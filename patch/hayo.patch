+    /** shuffle: true перемешать, false по порядку, null как сейчас выбрано в плеере. */
+    private void play(int start, Boolean shuffle) {
+        final ArrayList<HayoMusic.Track> tracks = tracks();
+        if (tracks.isEmpty()) return;
