+        fillDeck(all());
+        render();
+        if (top != null) {
+            top.setAlpha(0f);
+            top.setScaleX(0.9f);
+            top.setScaleY(0.9f);
+            top.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(260).setInterpolator(CubicBezierInterpolator.EASE_OUT_BACK).start();
+        }
+    }
