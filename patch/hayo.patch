+    private OwnLook look;
+    private HayoBadgeManager badgeManager;
+
+    private static int firstVisible(long me, java.util.List<org.telegram.margelet.MargeletBadge.Badge> list) {
+        for (int i = 0; i < list.size(); i++) {
+            if (!org.telegram.margelet.MargeletBadge.isHidden(me, list.get(i))) return i;
+        }
+        return -1;
+    }
+
+    /** Что сделать со своим значком: в основные, выше, ниже, скрыть или показать. */
+    private void badgeActions(int index) {
+        final long me = getUserConfig().getClientUserId();
+        final java.util.List<org.telegram.margelet.MargeletBadge.Badge> list = new java.util.ArrayList<>(org.telegram.margelet.MargeletBadge.ordered(me));
+        if (index < 0 || index >= list.size()) {
+            return;
+        }
+        final java.util.ArrayList<String> hidden = new java.util.ArrayList<>();
+        for (org.telegram.margelet.MargeletBadge.Badge b : list) {
+            if (org.telegram.margelet.MargeletBadge.isHidden(me, b)) hidden.add(b.id());
+        }
+        final org.telegram.margelet.MargeletBadge.Badge badge = list.get(index);
+        final boolean isHidden = hidden.contains(badge.id());
+        final CharSequence[] actions = {
+                LocaleController.getString(R.string.HayoBadgeMakeMain),
+                LocaleController.getString(R.string.HayoBadgeUp),
+                LocaleController.getString(R.string.HayoBadgeDown),
+                LocaleController.getString(isHidden ? R.string.HayoBadgeShow : R.string.HayoBadgeHide)};
+        new AlertDialog.Builder(getContext())
+                .setTitle(badge.title())
+                .setItems(actions, (d, which) -> {
+                    if (which == 0) {
+                        list.remove(index);
+                        list.add(0, badge);
+                        hidden.remove(badge.id());
+                    } else if (which == 1 && index > 0) {
+                        java.util.Collections.swap(list, index, index - 1);
+                    } else if (which == 2 && index < list.size() - 1) {
+                        java.util.Collections.swap(list, index, index + 1);
+                    } else if (which == 3) {
+                        if (isHidden) hidden.remove(badge.id()); else hidden.add(badge.id());
+                    }
+                    final String[] order = new String[list.size()];
+                    for (int i = 0; i < order.length; i++) order[i] = list.get(i).id();
+                    final String[] hide = hidden.toArray(new String[0]);
+                    org.telegram.margelet.MargeletBadge.setLocalPrefs(me, order, hide);
+                    org.telegram.margelet.HayoHelperBot.send("/gram_badges order=" + android.text.TextUtils.join(",", order)
+                            + " hide=" + android.text.TextUtils.join(",", hide), null, null);
+                    listView.adapter.update(true);
+                })
+                .show();
+    }
+
+    /** Свой баннер или градиент как есть, крупно. Нет ни того ни другого — так и написано. */
+    private class OwnLook extends android.view.View {
+        private final android.graphics.Paint paint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
+        private final android.text.TextPaint text = new android.text.TextPaint(android.graphics.Paint.ANTI_ALIAS_FLAG);
+        private final android.graphics.Rect src = new android.graphics.Rect();
+        private final android.graphics.RectF dst = new android.graphics.RectF();
+
+        OwnLook(android.content.Context context) {
+            super(context);
+        }
+
+        @Override
+        protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+            setMeasuredDimension(MeasureSpec.getSize(widthMeasureSpec), org.telegram.messenger.AndroidUtilities.dp(140));
+        }
+
+        @Override
+        protected void onDraw(android.graphics.Canvas canvas) {
+            final long me = getUserConfig().getClientUserId();
+            final int w = getWidth();
+            final int[] pair = MargeletGradient.of(me, this::invalidate);
+            final android.graphics.Bitmap banner = MargeletBanner.of(me, this::invalidate);
+            // градиент полосой снизу, баннер над ним: друг друга не закрывают
+            final int strip = pair != null ? org.telegram.messenger.AndroidUtilities.dp(44) : 0;
+            final int h = getHeight() - strip;
+            if (pair != null) {
+                MargeletGradient.paint(canvas, pair, 0, banner != null ? h : 0, w, getHeight(), 255);
+            }
+            if (banner != null) {
+                final float scale = Math.max((float) w / banner.getWidth(), (float) h / banner.getHeight());
+                final float bw = w / scale, bh = h / scale;
+                src.set((int) ((banner.getWidth() - bw) / 2), (int) ((banner.getHeight() - bh) / 2),
+                        (int) ((banner.getWidth() + bw) / 2), (int) ((banner.getHeight() + bh) / 2));
+                dst.set(0, 0, w, h);
+                canvas.drawBitmap(banner, src, dst, paint);
+            } else if (pair == null) {
+                final int hh = getHeight();
+                text.setTextSize(org.telegram.messenger.AndroidUtilities.dp(15));
+                text.setColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayText2));
+                final String none = LocaleController.getString(R.string.HayoOwnNothing);
+                canvas.drawText(none, (w - text.measureText(none)) / 2f, hh / 2f + org.telegram.messenger.AndroidUtilities.dp(5), text);
+            }
+        }
+    }
+
+    /** Через несколько секунд спросить сервер, принял ли бот изменение, и обновить экран. */
+    private void confirmLater() {
+        final long me = getUserConfig().getClientUserId();
+        for (int delay : new int[]{6000, 20000}) {
+            AndroidUtilities.runOnUIThread(() -> org.telegram.margelet.HayoHelperBot.recheck(me, info -> {
+                if (listView != null && listView.adapter != null) {
+                    listView.adapter.update(true);
+                }
+                if (look != null) {
+                    look.invalidate();
+                }
+            }), delay);
+        }
+    }
+
+    /** Спросить сервер заново, что стоит у меня, и перерисовать экран. */
+    private void refreshOwn() {
+        final long me = getUserConfig().getClientUserId();
+        org.telegram.margelet.HayoHelperBot.forget(me);
+        org.telegram.margelet.HayoHelperBot.info(me, info -> {
+            if (listView != null && listView.adapter != null) {
+                listView.adapter.update(true);
+            }
+            if (look != null) {
+                look.invalidate();
+            }
+        });
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshOwn();
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != PICK_BANNER || data == null || data.getData() == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        MargeletBanner.set(uri, () -> {
+            if (getContext() == null) {
+                return;
+            }
+            listView.adapter.update(true);
+            if (look != null) {
+                look.invalidate();
+            }
+            confirmLater();
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.info,
+                    LocaleController.getString(R.string.MargeletBannerSaved)).show();
+        });
+    }
+
+    // Как экраны самого телеграма: рисуемся под полоской жестов, а список
+    // получает снизу отступ на её высоту, вместо пустой полосы под ним.
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+
+    @Override
+    public void onInsets(int left, int top, int right, int bottom) {
+        if (listView != null) {
+            listView.setPadding(listView.getPaddingLeft(), listView.getPaddingTop(), listView.getPaddingRight(), bottom);
+            listView.setClipToPadding(false);
+        }
+    }
+}
