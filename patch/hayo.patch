+            secondary = p[1];
+            tertiary = p[2];
+            neutral = p[3];
+            neutralVariant = p[4];
+            return;
+        }
+        if (SYSTEM_IDS != null) {
+            try {
+                Context c = ApplicationLoader.applicationContext;
+                Palette[] out = new Palette[5];
+                for (int p = 0; p < 5; p++) {
+                    int[] colors = new int[13];
+                    for (int i = 0; i < 13; i++) {
+                        colors[i] = c.getColor(SYSTEM_IDS[p][i]);
+                    }
+                    out[p] = new SystemPalette(colors);
+                }
+                primary = out[0];
+                secondary = out[1];
+                tertiary = out[2];
+                neutral = out[3];
+                neutralVariant = out[4];
