+            case ID_EDIT_HISTORY:
+                org.telegram.margelet.HayoEdits.setEnabled(!org.telegram.margelet.HayoEdits.enabled());
+                listView.adapter.update(true);
+                return;
+            case ID_STREAK_FLAMES: {
+                final boolean on = !org.telegram.margelet.HayoStreaks.flamesEnabled();
+                org.telegram.margelet.HayoStreaks.setFlamesEnabled(on);
+                org.telegram.margelet.HayoStreaks.setPetEnabled(on);
+                // строка «Тилкайо в переписке» видна только при включённых сериях
+                listView.adapter.update(true);
+                break;
+            }
+            case ID_PET_IN_CHAT:
+                HayoPetFloat.setInChatEnabled(!HayoPetFloat.inChatEnabled());
+                toggled(view, HayoPetFloat.inChatEnabled());
+                break;
+            case ID_STREAK_PET:
