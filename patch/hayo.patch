@@ -0,0 +1,100 @@
+package org.telegram.ui;
+
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+
+import org.telegram.margelet.HayoMusic;
+import org.telegram.margelet.HayoMusicOnline;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.ItemOptions;
+
+/** Общие действия над треком: меню, лайк, «показать в чате», похожее. */
+final class HayoMusicActions {
+
+    private HayoMusicActions() {}
+
+    /**
+     * Меню трека. Есть track или message (или оба). from: плейлист, из
+     * которого трек можно убрать, или null.
+     */
+    static void menu(BaseFragment fragment, View anchor, HayoMusic.Track track, MessageObject message,
+                     BulletinFactory bulletins, HayoMusic.Playlist from, Runnable changed) {
+        if (fragment == null || anchor == null) return;
+        if (message == null && track != null) message = HayoMusicTiles.message(track);
+        final MessageObject msg = message;
+        final HayoMusic.Track one = track != null ? track : HayoMusic.track(msg);
+        if (one == null) return;
+        final boolean liked = HayoMusic.isLiked(one);
+        final ItemOptions options = ItemOptions.makeOptions(fragment, anchor);
+        options.add(liked ? R.drawable.hayo_ic_favorite_fill : R.drawable.hayo_ic_favorite,
+                LocaleController.getString(liked ? R.string.HayoUnlike : R.string.HayoLike),
+                () -> like(one, msg, bulletins, changed));
+        options.addIf(msg != null && HayoMusic.canAdd(msg), R.drawable.hayo_ic_playlist_add,
+                LocaleController.getString(R.string.HayoAddToPlaylist),
+                () -> HayoPlaylistPicker.show(fragment.getParentActivity(), msg, bulletins));
+        options.addIf(one.external() && HayoMusicOnline.available(), R.drawable.hayo_ic_radio,
+                LocaleController.getString(R.string.HayoSimilar), () -> similar(one, bulletins));
+        options.addIf(!one.external() && one.account == UserConfig.selectedAccount, R.drawable.hayo_ic_chat,
+                LocaleController.getString(R.string.HayoOpenInChat), () -> openInChat(fragment, one.dialogId, one.messageId));
+        if (from != null) {
+            options.add(R.drawable.hayo_ic_playlist_remove, LocaleController.getString(
+                    from.liked() ? R.string.HayoUnlike : R.string.HayoPlaylistRemove), true, () -> {
+                if (from.liked()) {
+                    HayoMusic.toggleLike(one, changed);
+                } else {
+                    HayoMusic.remove(from, one);
+                    if (changed != null) changed.run();
+                }
+            });
+        }
+        options.setGravity(Gravity.RIGHT);
+        options.show();
+    }
+
+    static void like(HayoMusic.Track track, MessageObject message, BulletinFactory bulletins, Runnable changed) {
+        final Runnable done = () -> {
+            final boolean now = track != null ? HayoMusic.isLiked(track) : HayoMusic.isLiked(message);
+            if (bulletins != null) {
+                bulletins.createSimpleBulletin(now ? R.raw.contact_check : R.raw.chats_infotip,
+                        LocaleController.getString(now ? R.string.HayoLikedAdded : R.string.HayoLikedRemoved)).show();
+            }
+            if (changed != null) changed.run();
+        };
+        if (message != null && (track == null || !track.external())) {
+            HayoMusic.toggleLike(message, done);
+        } else {
+            HayoMusic.toggleLike(track, done);
+        }
+    }
+
+    static void openInChat(BaseFragment fragment, long dialogId, int messageId) {
+        final Bundle args = new Bundle();
+        if (dialogId > 0) args.putLong("user_id", dialogId);
+        else args.putLong("chat_id", -dialogId);
+        args.putInt("message_id", messageId);
+        fragment.presentFragment(new ChatActivity(args));
+    }
+
+    /** Похожее на трек из сети: радио YouTube Music или рекомендации SoundCloud. */
+    static void similar(HayoMusic.Track track, BulletinFactory bulletins) {
+        HayoMusicOnline.related(track, 25, result -> {
+            if (!result.ok || result.items.isEmpty()) {
+                if (bulletins != null) {
+                    bulletins.createSimpleBulletin(R.raw.chats_infotip, result.ok
+                            ? LocaleController.getString(R.string.HayoSearchNothing) : result.errorText()).show();
+                }
+                return;
+            }
+            final java.util.ArrayList<HayoMusic.Track> list = new java.util.ArrayList<>();
+            list.add(track);
+            list.addAll(result.items);
+            HayoMusic.play(list, 0, null, LocaleController.getString(R.string.HayoSimilar));
+        });
+    }
+}
