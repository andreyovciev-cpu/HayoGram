+        self.plugin = plugin
+
+    def emit(self, record):
+        try:
+            текст = self.format(record)
+            мост = self.plugin._мост
+            if record.levelno >= logging.ERROR:
+                мост.error(текст)
+            else:
+                мост.log(текст)
+        except Exception:
+            pass
