+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Badges of OtherGram (another Telegram fork, github.com/cleveroze/OtherGram), shown next to
+ * Hayo Gram's own. Its backend gives them by user id, no key needed:
+ *
+ *   GET https://othergram-backend.othergram.workers.dev/v1/profiles?ids=1,2,3
+ *   {"users":{"1":{"badges":[{"id","title","label","description","color":int,"icon":"check"|"cross","style":"normal"|"rainbow"}]}}}
+ *
+ * As OtherGram does it itself: the ids of people whose names are drawn are gathered and asked
+ * for in batches of up to 100, answers are kept for 30 minutes, and a failed request waits
+ * 1, 2, 4… up to 30 minutes before the next, so their server is not leaned on.
+ */
+public final class HayoOtherGram {
+
+    private HayoOtherGram() {}
+
+    private static final String BASE = "https://othergram-backend.othergram.workers.dev";
+    private static final int BATCH = 100;
+    private static final long FRESH_MS = 30 * 60 * 1000L;
+    private static final long FIRST_BACKOFF_MS = 60 * 1000L, MOST_BACKOFF_MS = 30 * 60 * 1000L;
+
+    private static final Map<Long, List<MargeletBadge.Badge>> cache = new ConcurrentHashMap<>();
+    private static final Map<Long, Long> fetchedAt = new ConcurrentHashMap<>();
+    private static final Set<Long> asked = Collections.newSetFromMap(new ConcurrentHashMap<>());
+    private static final Set<Long> pending = new HashSet<>();
+    private static long backoff, retryAt;
+    private static boolean flushPosted;
+
+    public static boolean enabled() {
+        // По умолчанию выключено: чтобы показать чужие значки, приложение
+        // отправляет айди людей на сторонний сервер. Включать это должен
+        // человек сам, осознанно.
+        return MargeletConfig.prefs().getBoolean("othergram_badges", false);
+    }
+
+    public static void setEnabled(boolean on) {
+        MargeletConfig.prefs().edit().putBoolean("othergram_badges", on).apply();
+    }
+
+    /** This person's OtherGram badges, as Hayo Gram badges; empty while not known yet. */
+    static List<MargeletBadge.Badge> of(long peerId) {
+        if (peerId <= 0 || !enabled()) return Collections.emptyList();
+        List<MargeletBadge.Badge> known = cache.get(peerId);
+        Long at = fetchedAt.get(peerId);
+        if (known == null || at == null || System.currentTimeMillis() - at > FRESH_MS) ask(peerId);
+        return known == null ? Collections.emptyList() : known;
+    }
+
+    private static void ask(long peerId) {
+        if (!asked.add(peerId)) return;
+        synchronized (pending) {
+            pending.add(peerId);
+        }
+        AndroidUtilities.runOnUIThread(() -> {
+            if (flushPosted) return;
+            flushPosted = true;
+            long wait = Math.max(400L, retryAt - System.currentTimeMillis());
+            AndroidUtilities.runOnUIThread(HayoOtherGram::flush, wait);
+        });
+    }
+
+    private static void flush() {
+        flushPosted = false;
+        final List<Long> ids;
+        synchronized (pending) {
+            if (pending.isEmpty()) return;
+            ids = new ArrayList<>(pending);
+            pending.clear();
+        }
+        Utilities.run(() -> {
+            for (int from = 0; from < ids.size(); from += BATCH) {
+                List<Long> chunk = ids.subList(from, Math.min(ids.size(), from + BATCH));
+                if (!fetch(chunk)) {
+                    // the server is busy or over its limit: these are asked again after a pause
+                    for (Long id : ids.subList(from, ids.size())) asked.remove(id);
+                    backoff = backoff == 0 ? FIRST_BACKOFF_MS : Math.min(MOST_BACKOFF_MS, backoff * 2);
+                    retryAt = System.currentTimeMillis() + backoff;
+                    return;
+                }
+                backoff = 0;
+            }
+        });
+    }
+
+    private static boolean fetch(List<Long> ids) {
+        HttpURLConnection connection = null;
+        try {
+            StringBuilder list = new StringBuilder();
+            for (Long id : ids) list.append(list.length() > 0 ? "," : "").append(id);
+            connection = (HttpURLConnection) new URL(BASE + "/v1/profiles?ids=" + list).openConnection();
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(15000);
+            connection.setRequestProperty("Accept", "application/json");
+            connection.setRequestProperty("User-Agent", "HayoGram");
+            if (connection.getResponseCode() != 200) return false;
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            try (InputStream in = connection.getInputStream()) {
+                byte[] buffer = new byte[8192];
+                int n;
+                while ((n = in.read(buffer)) > 0 && out.size() < 1 << 20) out.write(buffer, 0, n);
+            }
+            JSONObject users = new JSONObject(out.toString("UTF-8")).optJSONObject("users");
+            long now = System.currentTimeMillis();
+            boolean changed = false;
+            for (Long id : ids) {
+                JSONObject user = users == null ? null : users.optJSONObject(String.valueOf(id));
+                List<MargeletBadge.Badge> badges = parse(id, user == null ? null : user.optJSONArray("badges"));
+                List<MargeletBadge.Badge> was = cache.put(id, badges);
+                fetchedAt.put(id, now);
+                asked.remove(id);
+                if (was == null ? !badges.isEmpty() : was.size() != badges.size()) changed = true;
+            }
+            if (changed) AndroidUtilities.runOnUIThread(HayoOtherGram::redraw);
+            return true;
+        } catch (Throwable error) {
+            FileLog.e(error);
+            return false;
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    private static List<MargeletBadge.Badge> parse(long peerId, JSONArray array) {
+        if (array == null || array.length() == 0) return Collections.emptyList();
+        List<MargeletBadge.Badge> out = new ArrayList<>();
+        for (int i = 0; i < array.length(); i++) {
+            JSONObject b = array.optJSONObject(i);
+            if (b == null) continue;
+            try {
+                JSONObject remote = new JSONObject();
+                String label = b.optString("label", "");
+                remote.put("id", "og_" + b.optString("id", String.valueOf(i)));
+                remote.put("title", label.length() > 0 ? label : b.optString("title", "OtherGram"));
+                remote.put("about", b.optString("description", ""));
+                remote.put("othergram", true);
+                remote.put("icon", "cross".equals(b.optString("icon")) ? "cross" : "check");
+                remote.put("style", "rainbow".equals(b.optString("style")) ? "rainbow" : "normal");
+                out.add(new MargeletBadge.Badge(peerId, remote, b.optInt("color", 0xFF8DD1B0) | 0xFF000000, null));
+            } catch (Throwable ignored) {
+            }
+        }
+        return out;
+    }
+
+    private static void redraw() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (UserConfig.getInstance(a).isClientActivated()) {
+                NotificationCenter.getInstance(a).postNotificationName(NotificationCenter.updateInterfaces,
+                        MessagesController.UPDATE_MASK_NAME);
+            }
+        }
+    }
+
+    /** Is this badge one of OtherGram's. */
+    static boolean is(MargeletBadge.Badge badge) {
+        return badge != null && badge.remote() != null && badge.remote().optBoolean("othergram");
+    }
+
+    /** OtherGram's look: a round field in the badge's colour (or a rainbow) with a check or a cross. */
+    static Drawable icon(MargeletBadge.Badge badge) {
+        final boolean cross = "cross".equals(badge.remote().optString("icon"));
+        final boolean rainbow = "rainbow".equals(badge.remote().optString("style"));
+        final int color = badge.color;
+        return new Drawable() {
+            final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG), mark = new Paint(Paint.ANTI_ALIAS_FLAG);
+            final Path path = new Path();
+            final RectF box = new RectF();
+
+            @Override
+            public void draw(Canvas canvas) {
+                box.set(getBounds());
+                float r = Math.min(box.width(), box.height()) / 2f;
+                if (rainbow) {
+                    fill.setShader(new LinearGradient(box.left, box.top, box.right, box.bottom,
+                            new int[] {0xFFFF6B6B, 0xFFFFD93D, 0xFF6BCB77, 0xFF4D96FF, 0xFFB15CFF}, null, Shader.TileMode.CLAMP));
+                } else {
+                    fill.setShader(null);
+                    fill.setColor(color);
+                }
+                canvas.drawCircle(box.centerX(), box.centerY(), r, fill);
+                mark.setColor(0xFFFFFFFF);
+                mark.setStyle(Paint.Style.STROKE);
+                mark.setStrokeCap(Paint.Cap.ROUND);
+                mark.setStrokeJoin(Paint.Join.ROUND);
+                mark.setStrokeWidth(r * 0.24f);
+                path.reset();
+                float cx = box.centerX(), cy = box.centerY(), u = r * 0.42f;
+                if (cross) {
+                    path.moveTo(cx - u, cy - u); path.lineTo(cx + u, cy + u);
+                    path.moveTo(cx + u, cy - u); path.lineTo(cx - u, cy + u);
+                } else {
+                    path.moveTo(cx - u, cy + u * 0.05f); path.lineTo(cx - u * 0.25f, cy + u * 0.75f); path.lineTo(cx + u, cy - u * 0.6f);
+                }
+                canvas.drawPath(path, mark);
+            }
+
+            @Override public void setAlpha(int alpha) { fill.setAlpha(alpha); mark.setAlpha(alpha); }
+            @Override public void setColorFilter(ColorFilter filter) {}
+            @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+            @Override public int getIntrinsicWidth() { return AndroidUtilities.dp(24); }
+            @Override public int getIntrinsicHeight() { return AndroidUtilities.dp(24); }
+        };
+    }
+
+    private static final class Utilities {
+        static void run(Runnable work) {
+            Thread thread = new Thread(work, "hayo-othergram");
+            thread.setDaemon(true);
+            thread.start();
+        }
+    }
+}
