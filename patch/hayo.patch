+                toggled(view, MargeletConfig.tagsEnabled());
+                break;
+            case ID_COPY:
+                MargeletConfig.setCopyFormatting(!MargeletConfig.copyFormatting());
+                toggled(view, MargeletConfig.copyFormatting());
+                break;
+            case ID_PROXY:
+                MargeletProxy.enable(!MargeletConfig.proxyEnabled());
+                // включение может не удаться: показываем то, что вышло на деле
+                toggled(view, MargeletConfig.proxyEnabled());
+                break;
+            case ID_FONTS:
+                presentFragment(new MargeletFontsActivity());
+                break;
+            case ID_INPUT:
+            case ID_MARKUP:
+                presentFragment(new MargeletMarkupActivity());
+                break;
+            case ID_MY_PROFILE:
+                presentFragment(new MargeletProfileActivity());
+                break;
+            case ID_STREAMER:
+                presentFragment(new MargeletStreamerActivity());
+                break;
+            case ID_PLUGINS:
+                presentFragment(new MargeletPluginsActivity());
+                break;
+            case ID_UPDATES:
+                presentFragment(new MargeletUpdatesActivity());
+                break;
+            case ID_SOUND:
+                presentFragment(new MargeletSoundActivity());
+                break;
+            case ID_STICKERS:
+                Browser.openUrl(getContext(), MargeletConfig.STICKERS_URL);
+                break;
+            case ID_CHANNEL:
+                Browser.openUrl(getContext(), MargeletConfig.CHANNEL_URL);
+                break;
+            case ID_FORUM:
+                Browser.openUrl(getContext(), MargeletConfig.FORUM_URL);
