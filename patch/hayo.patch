+                break;
+            case ID_SEIZURE:
+                toggleSeizure(view);
+                break;
+            case ID_SAVE_DELETED:
+                org.telegram.margelet.HayoDeleted.setEnabled(!org.telegram.margelet.HayoDeleted.enabled());
