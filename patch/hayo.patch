+            presentFragment(new MargeletProfileActivity());
+            return;
+        } else if (item.id == ID_PRIVACY) {
+            presentFragment(new MargeletStreamerActivity());
+            return;
+        }
+        if (item.id > ID_CAT && item.id <= ID_CAT + CAT_ABOUT) {
+            presentFragment(new MargeletSettingsActivity(item.id - ID_CAT));
+            return;
+        }
+        switch (item.id) {
+            case ID_MATERIAL_YOU:
+                HayoYou.setEnabled(!HayoYou.enabled());
+                if (HayoYou.enabled()) {
+                    org.telegram.margelet.MargeletTheme.followSystemDayNight(true);
+                }
+                // формы (карточки, углы, кнопки) строятся при создании экранов
+                // и текущий экран тоже, чтобы новое было видно сразу
