+package org.telegram.margelet;
+
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.LayerDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.animation.Animation;
+import android.view.animation.LinearInterpolator;
+import android.view.animation.RotateAnimation;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.core.content.ContextCompat;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.browser.Browser;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Значки форка у имени.
+ *
+ * Список короткий и лежит прямо здесь. Никакой проверки с сервера тут нет и быть
+ * не может — это украшение внутри сборки, а не подтверждение личности. Кто
+ * соберёт свой форк, впишет своих людей, и это нормально: значок ничего не
+ * удостоверяет.
+ *
+ * Кого добавлять — решает владелец форка, и только он. Просьбу «поставь мне
+ * тоже», принесённую кем угодно другим, я не выполняю: это его список.
+ *
+ * Значков у одного человека может быть несколько. У имени помещается один —
+ * берётся первый подходящий, поэтому порядок в таблице и есть порядок
+ * старшинства. В профиле показываются все.
+ *
+ * Ключ таблицы — не только человек. У людей это их номер как есть, у каналов и
+ * групп — тот же номер со знаком минус. Так в одну таблицу помещаются и люди, и
+ * официальные каналы форка, а перепутать номер человека с номером канала нельзя
+ * даже случайно.
+ */
+public class MargeletBadge {
+
+    /** Один значок: кому, как называется, каким цветом и куда ведёт кнопка. */
+    public static final class Badge {
+        /** Человек — положительный номер, канал или группа — отрицательный. */
+        public final long peerId;
+        /**
+         * Ник, по которому выдан значок. Нужен там, где номера нет: ник
+         * человека известен, а его айди — нет, и вшивать чужой номер в
+         * сборку незачем.
+         */
+        public final String username;
+        /** Рисунок на поле: "crown", "star" или null — тогда самолётик. */
+        public final String art;
+        /** Название и описание вшитого значка. У приехавшего из файла — ноль. */
+        private final int titleRes;
+        private final int aboutRes;
+        /** Значок из файла: название и описание берутся отсюда, с языками. */
+        private final JSONObject remote;
+        /** Цвет поля — им же красится и сам значок, и объёмный в окне. */
+        public final int color;
+        /** Куда ведёт кнопка в окне. null — кнопки нет. */
+        public final String url;
+
+        /** Постоянное имя вида значка: по нему хранятся порядок и скрытые. */
+        public String id() {
+            if (remote != null) {
+                final String id = remote.optString("id", "");
+                if (!id.isEmpty()) return id;
+                if ("supporter".equals(remote.optString("kind", ""))) return "supporter";
+                return remote.optString("title", "").toLowerCase().replace(' ', '_');
+            }
+            return builtInId;
+        }
+
+        private String builtInId = "";
+
+        Badge(String id, long peerId, int titleRes, int aboutRes, int color, String url) {
+            this(peerId, titleRes, aboutRes, color, url);
+            this.builtInId = id;
+        }
+
+        /** Вшитый значок по нику: номера у нас нет, искать будем по нику. */
+        Badge(String id, String username, int titleRes, int aboutRes, int color, String art, String url) {
+            this.peerId = 0;
+            this.username = username;
+            this.art = art;
+            this.titleRes = titleRes;
+            this.aboutRes = aboutRes;
+            this.remote = null;
+            this.color = color;
+            this.url = url;
+            this.builtInId = id;
+        }
+
+        Badge(long peerId, int titleRes, int aboutRes, int color, String url) {
+            this.peerId = peerId;
+            this.username = null;
+            this.art = null;
+            this.titleRes = titleRes;
+            this.aboutRes = aboutRes;
+            this.remote = null;
+            this.color = color;
+            this.url = url;
+        }
+
+        Badge(long peerId, JSONObject remote, int color, String url) {
+            this.peerId = peerId;
+            final String name = remote.optString("username", "");
+            this.username = name.isEmpty() ? null : name;
+            final String icon = remote.optString("icon", "");
+            this.art = ("crown".equals(icon) || "star".equals(icon)) ? icon : null;
+            this.titleRes = 0;
+            this.aboutRes = 0;
+            this.remote = remote;
+            this.color = color;
+            this.url = url;
+        }
+
+        /**
+         * Этот значок — про данного человека? Сперва номер: он точнее всего.
+         * Если номера нет, сверяем ник так, как его пишут в телеграме, — без
+         * учёта регистра.
+         */
+        boolean matches(long id) {
+            if (peerId != 0 && peerId == id) {
+                return true;
+            }
+            if (username == null || username.isEmpty() || id == 0) {
+                return false;
+            }
+            final String actual = usernameOf(id);
+            return actual != null && actual.equalsIgnoreCase(username);
+        }
+
+        /** Есть ли у значка свой рисунок вместо самолётика. */
+        public boolean hasArt() {
+            return art != null && !art.isEmpty();
+        }
+
+        /**
+         * Название значка. У вшитых берётся из строк приложения, а не
+         * запоминается заранее: человек может переключить язык, не выходя.
+         */
+        public String title() {
+            return remote != null ? MargeletRemote.localized(remote, "title", "") : LocaleController.getString(titleRes);
+        }
+
+        public String about() {
+            return remote != null ? MargeletRemote.localized(remote, "about", "") : LocaleController.getString(aboutRes);
+        }
+
+        /** The badge as it came from a file or a server, or null for a built-in one. */
+        JSONObject remote() {
+            return remote;
+        }
+    }
+
+    /**
+     * Вшитый запас. Работает, пока файл ни разу не скачался: на свежей
+     * установке без интернета значки должны быть на месте, а не появляться
+     * через минуту после первого удачного запроса.
+     */
+    private static final Badge[] BUILT_IN = {
+            // Два владельца форка. Ники, а не номера: чужие номера в сборке
+            // не нужны, а ник человек при желании меняет сам — тогда значок
+            // просто перестанет находиться, и это честнее вшитого айди.
+            new Badge("owner_hayozimi", "hayozimi", R.string.MargeletBadgeTitle, R.string.MargeletBadgeAbout,
+                    0xFF8DD1B0, "crown", "https://t.me/hayozimi"),
+            new Badge("owner_zarrokk", "zarrokk", R.string.MargeletBadgeTitle, R.string.MargeletBadgeAbout,
+                    0xFFB7A8E0, "star", "https://t.me/zarrokk"),
+    };
+
+    /** Файл со значками в репозитории и ключ, под которым он лежит в кэше. */
+    // значки лежат в репозитории: правятся без выпуска, а зеркала и чужие
+    // серверы для этого не нужны
+    private static final String FILE = MargeletRemote.BASE + "badges.json";
+    private static final String CACHE_KEY = "badges";
+
+    /** Разобранный список. null — ещё не разбирали или разбирать было нечего. */
+    private static Badge[] parsed;
+    /** Язык, на котором разбирали: сменился — придётся разобрать заново. */
+    private static String parsedLanguage;
+
+    /**
+     * Перечитывает список с гитхаба. Зовётся при запуске приложения.
+     *
+     * Ответа никто не ждёт: пока он едет, показывается прошлый список, а на
+     * свежей установке — вшитый.
+     */
+    public static void refresh() {
+        MargeletRemote.fetch(FILE, CACHE_KEY, text -> {
+            if (text != null) {
+                parsed = null;      // приехало новое — разберём при первом спросе
+                // перерисовать имена в списках и шапках с новыми значками
+                for (int a = 0; a < org.telegram.messenger.UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                    if (org.telegram.messenger.UserConfig.getInstance(a).isClientActivated()) {
+                        org.telegram.messenger.NotificationCenter.getInstance(a).postNotificationName(
+                                org.telegram.messenger.NotificationCenter.updateInterfaces,
+                                org.telegram.messenger.MessagesController.UPDATE_MASK_NAME);
+                    }
+                }
+            }
+        });
+    }
+
+    /** При возвращении в приложение: список старше пяти минут — перечитать. */
+    public static void refreshIfStale() {
+        if (System.currentTimeMillis() - MargeletRemote.cachedAt(CACHE_KEY) > 5 * 60 * 1000L) {
+            refresh();
+        }
+    }
+
+    /**
+     * Список, по которому и работают все проверки: разобранный файл, если он
+     * есть, иначе вшитый.
+     */
+    private static Badge[] badges() {
+        final String language = language();
+        if (parsed != null && equal(parsedLanguage, language)) {
+            return parsed;
+        }
+        final String text = MargeletRemote.cached(CACHE_KEY);
+        if (text == null) {
+            return BUILT_IN;
+        }
+        final Badge[] fromFile = parse(text);
+        if (fromFile == null || fromFile.length == 0) {
+            // Файл битый или пустой. Молча остаёмся на вшитом: пустой список
+            // значков выглядел бы как «у всех всё отобрали».
+            return BUILT_IN;
+        }
+        parsed = fromFile;
+        parsedLanguage = language;
+        return parsed;
+    }
+
+    private static boolean equal(String a, String b) {
+        return a == null ? b == null : a.equals(b);
+    }
+
+    private static String language() {
+        try {
+            return LocaleController.getInstance().getCurrentLocale().getLanguage();
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    /**
+     * Ник человека по номеру. Нужен значкам, выданным по нику: айди
+     * @hayozimi и @zarrokk в сборку не вшиты.
+     *
+     * Сперва свой аккаунт — его ник лежит в настройках и доступен всегда.
+     * Потом кэш сообщений: в профиле и в списке чатов человек уже загружен,
+     * так что значок находится сразу. Никаких запросов в сеть отсюда нет:
+     * значок — украшение и не повод что-то скачивать.
+     */
+    private static String usernameOf(long peerId) {
+        if (peerId == 0) {
+            return null;
+        }
+        try {
+            for (int a = 0; a < org.telegram.messenger.UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                final org.telegram.messenger.UserConfig config =
+                        org.telegram.messenger.UserConfig.getInstance(a);
+                if (!config.isClientActivated()) {
+                    continue;
+                }
+                if (config.getClientUserId() == peerId) {
+                    final org.telegram.tgnet.TLRPC.User self = config.getCurrentUser();
+                    if (self != null && self.username != null && !self.username.isEmpty()) {
+                        return self.username;
+                    }
+                }
+                final org.telegram.tgnet.TLRPC.User user =
+                        org.telegram.messenger.MessagesController.getInstance(a).getUser(peerId);
+                if (user != null && user.username != null && !user.username.isEmpty()) {
+                    return user.username;
+                }
+            }
+        } catch (Throwable ignored) {
+        }
+        return null;
+    }
+
+    /**
+     * Разбор файла. Формат нарочно простой, чтобы владелец правил его руками:
+     *
+     * [ { "username": "hayozimi", "title": "...", "title_ru": "...",
+     *     "about": "...", "color": "8DD1B0", "icon": "crown", "url": "..." } ]
+     *
+     * Вместо username можно указать peer — номер человека или чата. Ник
+     * удобнее: его видно в телеграме, и он не меняется при пересылке.
+     *
+     * Цвет — шестнадцатеричный, с решёткой или без, с прозрачностью или без.
+     * Строка, которую разобрать не вышло, пропускается: из-за одной опечатки
+     * не должен пропадать весь список.
+     */
+    private static Badge[] parse(String text) {
+        final List<Badge> out = new ArrayList<>();
+        final java.util.HashMap<Long, String[][]> prefs = new java.util.HashMap<>();
+        try {
+            final JSONArray array = new JSONArray(text);
+            for (int i = 0; i < array.length(); i++) {
+                try {
+                    final JSONObject item = array.getJSONObject(i);
+                    if (item.has("prefs")) {
+                        prefs.put(item.getLong("prefs"), new String[][]{strings(item.optJSONArray("order")), strings(item.optJSONArray("hidden"))});
+                        continue;
+                    }
+                    final long peer = item.optLong("peer", 0);
+                    final String username = item.optString("username", "");
+                    if (peer == 0 && username.isEmpty()) {
+                        // ни номера, ни ника — не за кем закреплять
+                        continue;
+                    }
+                    final String url = item.optString("url", null);
+                    out.add(new Badge(peer, item, color(item.optString("color", null)),
+                            url == null || url.isEmpty() ? null : url));
+                } catch (Exception ignored) {
+                }
+            }
+        } catch (Exception ignored) {
+            return null;
+        }
+        serverPrefs = prefs;
+        return out.toArray(new Badge[0]);
+    }
+
+    private static String[] strings(JSONArray array) {
+        if (array == null) return new String[0];
+        final String[] out = new String[array.length()];
+        for (int i = 0; i < out.length; i++) out[i] = array.optString(i, "");
+        return out;
+    }
+
+    /** Порядок и скрытые значки людей, как они сами выставили через бота. */
+    private static java.util.Map<Long, String[][]> serverPrefs = new java.util.HashMap<>();
+    /** Своё только что выставленное, пока сервер не подтвердил. */
+    private static final java.util.HashMap<Long, String[][]> localPrefs = new java.util.HashMap<>();
+
+    public static void setLocalPrefs(long peerId, String[] order, String[] hidden) {
+        localPrefs.put(peerId, new String[][]{order, hidden});
+    }
+
+    private static String[][] prefsOf(long peerId) {
+        final String[][] local = localPrefs.get(peerId);
+        return local != null ? local : serverPrefs.get(peerId);
+    }
+
+    /** Все значки человека как в таблице, без его порядка и скрытия: для экрана управления. */
+    public static List<Badge> raw(long peerId) {
+        final List<Badge> found = new ArrayList<>();
+        for (Badge badge : badges()) {
+            if (badge.matches(peerId)) {
+                boolean dup = false;
+                for (Badge b : found) if (b.id().equals(badge.id())) dup = true;
+                if (!dup) found.add(badge);
+            }
+        }
+        return found;
+    }
+
+    public static boolean isHidden(long peerId, Badge badge) {
+        final String[][] p = prefsOf(peerId);
+        if (p == null) return false;
+        for (String h : p[1]) if (h.equals(badge.id())) return true;
+        return false;
+    }
+
+    /** Порядок человека: выставленные сначала, остальные следом как в таблице. */
+    public static List<Badge> ordered(long peerId) {
+        final List<Badge> found = raw(peerId);
+        final String[][] p = prefsOf(peerId);
+        if (p == null) return found;
+        final List<String> order = java.util.Arrays.asList(p[0]);
+        java.util.Collections.sort(found, (a, b) -> {
+            int ia = order.indexOf(a.id()), ib = order.indexOf(b.id());
+            if (ia < 0) ia = Integer.MAX_VALUE;
+            if (ib < 0) ib = Integer.MAX_VALUE;
+            return Integer.compare(ia, ib);
+        });
+        return found;
+    }
+
+    /** Цвет поля значка. Не разобрали — зелёный, он же основной. */
+    private static int color(String value) {
+        if (value == null) {
+            return 0xFF8DD1B0;
+        }
+        String hex = value.trim();
+        if (hex.startsWith("#")) {
+            hex = hex.substring(1);
+        }
+        try {
+            final long parsedColor = Long.parseLong(hex, 16);
+            // Написали шесть знаков — значит про прозрачность не думали,
+            // дорисовываем непрозрачность сами.
+            return hex.length() <= 6 ? (int) (0xFF000000L | parsedColor) : (int) parsedColor;
+        } catch (Exception ignored) {
+            return 0xFF8DD1B0;
+        }
+    }
+
+    /** Номер канала или группы в том виде, в каком он лежит в таблице. */
+    public static long chatPeer(long chatId) {
+        return -chatId;
+    }
+
+    /**
+     * Виды значков — по одному на вид, а не по одному на человека.
+     *
+     * В таблице «кот в Margelet» стоит дважды: котов двое, у каждого свой
+     * хозяин. Витрине это не нужно — она показывает, какие значки бывают, и
+     * два одинаковых «Кот в Margelet» там выглядят ошибкой. Ею и были.
+     */
+    public static Badge[] list() {
+        final List<Badge> kinds = new ArrayList<>();
+        for (Badge badge : badges()) {
+            boolean seen = false;
+            for (Badge already : kinds) {
+                if (already.id().equals(badge.id())) {
+                    seen = true;
+                    break;
+                }
+            }
+            if (!seen) {
+                kinds.add(badge);
+            }
+        }
+        return kinds.toArray(new Badge[0]);
+    }
+
+    /** Старший значок — тот, что стоит у имени. Первый в таблице и есть старший. */
+    public static Badge of(long peerId) {
+        final List<Badge> all = all(peerId);
+        return all.isEmpty() ? null : all.get(0);
+    }
+
+    /** Все значки этого человека или чата, по старшинству. */
+    public static List<Badge> all(long peerId) {
+        final List<Badge> found = new ArrayList<>();
+        if (!MargeletConfig.badgesEnabled()) {
+            return found;
+        }
+        // в порядке, который выставил сам человек, без скрытых им
+        for (Badge badge : ordered(peerId)) {
+            if (!isHidden(peerId, badge)) {
+                found.add(badge);
+            }
+        }
+        // and the ones this person has in OtherGram, after ours
+        for (Badge badge : HayoOtherGram.of(peerId)) {
+            if (!isHidden(peerId, badge)) {
+                found.add(badge);
+            }
+        }
+        return found;
+    }
+
+    public static boolean has(long peerId) {
+        return of(peerId) != null;
+    }
+
+    /**
+     * Картинка значка у имени или null, если такого в таблице нет.
+     *
+     * Картинка одна на всех, а цвет поля свой у каждого значка: он приезжает
+     * из файла строкой вида «8DD1B0», и заводить по вектору на каждый новый
+     * цвет незачем. Поле рисуется скруглённым квадратом, самолётик кладётся
+     * сверху отдельным слоем.
+     */
+    public static Drawable iconDrawable(Context context, long peerId) {
+        return iconDrawable(context, of(peerId));
+    }
+
+    /**
+     * Имя со значком сразу за ним, отдельной картинкой внутри текста. Так значку
+     * не нужен свой слот у ячейки, и он стоит рядом с эмодзи-статусом, галочкой
+     * и значком «звук выключен», а не вместо них.
+     */
+    public static CharSequence withBadge(Context context, CharSequence name, long peerId) {
+        if (name == null || peerId == 0) {
+            return name;
+        }
+        final List<Badge> all = all(peerId);
+        if (all.isEmpty()) {
+            return name;
+        }
+        final android.text.SpannableStringBuilder sb = new android.text.SpannableStringBuilder(name);
+        for (Badge badge : shown(all)) {
+            final Drawable icon = iconDrawable(context, badge);
+            if (icon == null) continue;
+            final int at = sb.length();
+            sb.append(" \u2060");
+            sb.setSpan(new BadgeSpan(icon), at + 1, at + 2, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        }
+        return sb;
+    }
+
+    /** Ширина, которую значок в имени займёт при этом размере текста. */
+    public static float badgeWidth(android.graphics.Paint paint) {
+        return paint.getTextSize() * 0.95f + paint.measureText(" ");
+    }
+
+    /** At the name: the main badge only, everywhere. The rest are in the profile. */
+    private static List<Badge> shown(List<Badge> all) {
+        final List<Badge> out = new ArrayList<>();
+        if (!all.isEmpty()) out.add(all.get(0));
+        return out;
+    }
+
+    /** The width all of this person's badges at the name take. */
+    public static float badgeWidth(android.graphics.Paint paint, long peerId) {
+        return badgeWidth(paint) * Math.max(1, shown(all(peerId)).size());
+    }
+
+    public static final class BadgeSpan extends android.text.style.ReplacementSpan {
+        private final Drawable icon;
+
+        BadgeSpan(Drawable icon) {
+            this.icon = icon;
+        }
+
+        @Override
+        public int getSize(android.graphics.Paint paint, CharSequence text, int start, int end, android.graphics.Paint.FontMetricsInt fm) {
+            return Math.round(paint.getTextSize() * 0.95f);
+        }
+
+        @Override
+        public void draw(android.graphics.Canvas canvas, CharSequence text, int start, int end, float x, int top, int y, int bottom, android.graphics.Paint paint) {
+            final int size = Math.round(paint.getTextSize() * 0.95f);
+            final android.graphics.Paint.FontMetricsInt fm = paint.getFontMetricsInt();
+            final int center = y + (fm.ascent + fm.descent) / 2;
+            icon.setBounds((int) x, center - size / 2, (int) x + size, center - size / 2 + size);
+            icon.setAlpha(paint.getAlpha());
+            icon.draw(canvas);
+        }
+    }
+
+    /**
+     * Белый рисунок поверх цветного поля: корона у владельца, звезда у
+     * второго. Рисуется путём, а не картинкой: цвет поля приезжает из файла,
+     * и заводить по вектору на каждый оттенок незачем.
+     */
+    private static final class ArtDrawable extends android.graphics.drawable.Drawable {
+        private final android.graphics.Path path = new android.graphics.Path();
+        private final android.graphics.Paint paint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
+        private final String art;
+
+        ArtDrawable(String art) {
+            this.art = art;
+            paint.setColor(0xFFFFFFFF);
+            paint.setStyle(android.graphics.Paint.Style.FILL);
+        }
+
+        @Override
+        public void draw(android.graphics.Canvas canvas) {
+            final android.graphics.Rect bounds = getBounds();
+            if (bounds.isEmpty()) {
+                return;
+            }
+            final float side = Math.min(bounds.width(), bounds.height());
+            final float left = bounds.left + (bounds.width() - side) / 2f;
+            final float top = bounds.top + (bounds.height() - side) / 2f;
+            // Рисунок занимает середину поля: по краям остаётся цветная кайма,
+            // и значок читается как значок, а не как наклейка во всё поле.
+            final float pad = side * 0.24f;
+            final float size = side - pad * 2f;
+            path.reset();
+            if ("star".equals(art)) {
+                star(path, left + side / 2f, top + side / 2f, size / 2f);
+            } else {
+                crown(path, left + pad, top + pad, size);
+            }
+            canvas.drawPath(path, paint);
+        }
+
+        private static void crown(android.graphics.Path p, float x, float y, float s) {
+            // Три зубца и подставка; координаты — доли стороны.
+            p.moveTo(x + s * 0.06f, y + s * 0.66f);
+            p.lineTo(x + s * 0.06f, y + s * 0.20f);
+            p.lineTo(x + s * 0.34f, y + s * 0.44f);
+            p.lineTo(x + s * 0.50f, y + s * 0.08f);
+            p.lineTo(x + s * 0.66f, y + s * 0.44f);
+            p.lineTo(x + s * 0.94f, y + s * 0.20f);
+            p.lineTo(x + s * 0.94f, y + s * 0.66f);
+            p.close();
+            p.moveTo(x + s * 0.06f, y + s * 0.78f);
+            p.lineTo(x + s * 0.94f, y + s * 0.78f);
+            p.lineTo(x + s * 0.94f, y + s * 0.92f);
+            p.lineTo(x + s * 0.06f, y + s * 0.92f);
+            p.close();
+        }
+
+        private static void star(android.graphics.Path p, float cx, float cy, float radius) {
+            for (int i = 0; i < 10; i++) {
+                final double angle = -Math.PI / 2 + i * Math.PI / 5;
+                final float r = (i % 2 == 0) ? radius : radius * 0.42f;
+                final float px = cx + (float) (Math.cos(angle) * r);
+                final float py = cy + (float) (Math.sin(angle) * r);
+                if (i == 0) {
+                    p.moveTo(px, py);
+                } else {
+                    p.lineTo(px, py);
+                }
+            }
+            p.close();
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            paint.setAlpha(alpha);
+        }
+
+        @Override
+        public void setColorFilter(android.graphics.ColorFilter colorFilter) {
+            paint.setColorFilter(colorFilter);
+        }
+
+        @Override
+        public int getOpacity() {
+            return android.graphics.PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    public static Drawable iconDrawable(Context context, Badge badge) {
+        if (context == null || badge == null) {
+            return null;
+        }
+        if (HayoOtherGram.is(badge)) {
+            return HayoOtherGram.icon(badge);
+        }
+        try {
+            final GradientDrawable field = new GradientDrawable();
+            field.setShape(GradientDrawable.RECTANGLE);
+            // Скругление то же, что было в векторе: пять частей из двадцати
+            // четырёх, пересчитанные в точки экрана.
+            field.setCornerRadius(AndroidUtilities.dp(24) * 5f / 24f);
+            field.setColor(badge.color);
+            final Drawable symbol;
+            if (badge.hasArt()) {
+                symbol = new ArtDrawable(badge.art);
+            } else {
+                symbol = ContextCompat.getDrawable(context, R.drawable.margelet_badge_plane);
+            }
+            if (symbol == null) {
+                return field;
+            }
+            return new LayerDrawable(new Drawable[]{field, symbol});
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /**
+     * Название значка. Отдаётся строкой, а не CharSequence: в профиле оно
+     * ложится в поле описания для озвучки, а там объявлен String.
+     */
+    public static String title(long peerId) {
+        final Badge badge = of(peerId);
+        return badge == null ? null : badge.title();
+    }
+
+    public static void show(Context context, long peerId) {
+        show(context, of(peerId));
+    }
+
+    public static void show(Context context, Badge badge) {
+        if (context == null || badge == null) {
+            return;
+        }
+        try {
+            final LinearLayout layout = new LinearLayout(context);
+            layout.setOrientation(LinearLayout.VERTICAL);
+            layout.setGravity(Gravity.CENTER_HORIZONTAL);
+
+            // Объёмный значок: сам крутится, можно крутить пальцем. Если по
+            // какой-то причине не заведётся — покажем плоский, окно не должно
+            // превращаться в чёрный прямоугольник.
+            View spinner;
+            if (HayoOtherGram.is(badge) || badge.hasArt()) {
+                // Чужой значок и наш рисунок стоят на месте: объёмная модель
+                // сделана под самолётик, и короне с звездой она не идёт.
+                final ImageView still = new ImageView(context);
+                still.setImageDrawable(iconDrawable(context, badge));
+                spinner = still;
+            } else try {
+                spinner = new MargeletPlane3D(context, badge.color);
+            } catch (Throwable t) {
+                final ImageView icon = new ImageView(context);
+                icon.setImageDrawable(iconDrawable(context, badge));
+                final RotateAnimation spin = new RotateAnimation(0, 360,
+                        Animation.RELATIVE_TO_SELF, 0.5f, Animation.RELATIVE_TO_SELF, 0.5f);
+                spin.setDuration(2600);
+                spin.setRepeatCount(Animation.INFINITE);
+                spin.setInterpolator(new LinearInterpolator());
+                icon.startAnimation(spin);
+                spinner = icon;
+            }
+            layout.addView(spinner, LayoutHelper.createLinear(150, 150, Gravity.CENTER_HORIZONTAL, 0, 4, 0, 12));
+
+            final TextView text = new TextView(context);
+            text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+            text.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+            text.setGravity(Gravity.CENTER);
+            text.setText(HayoOtherGram.is(badge)
+                    ? (badge.about().length() > 0 ? badge.about() + "\n\n" : "") + LocaleController.getString(R.string.HayoOtherGramBadge)
+                    : badge.about());
+            layout.addView(text, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT,
+                    LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL, 8, 0, 8, 0));
+
+            final AlertDialog.Builder builder = new AlertDialog.Builder(context)
+                    .setTitle(badge.title())
+                    .setView(layout);
+            if (badge.url != null) {
+                builder.setPositiveButton(LocaleController.getString(R.string.MargeletBadgeChannel),
+                        (d, w) -> Browser.openUrl(context, badge.url));
+            }
+            builder.setNegativeButton(LocaleController.getString(R.string.Close), null).show();
+        } catch (Exception ignored) {
+            // Украшение не повод ронять профиль.
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/margelet/MargeletBanner.java b/TMessagesProj/src/main/java/org/telegram/margelet/MargeletBanner.java
