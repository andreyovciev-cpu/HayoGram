index 00000000..e0aa0d2b
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/HayoChatPreview.java
@@ -0,0 +1,241 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffColorFilter;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+
+import org.telegram.margelet.MargeletConfig;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.ChatMessageCell;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.MotionBackgroundDrawable;
+import org.telegram.ui.Stories.recorder.StoryEntry;
+
+/**
+ * Кусок настоящего чата для экранов настроек: те же ячейки сообщений, что в
+ * переписке, на тех же обоях, и, если надо, поле ввода из тех же значков.
+ * Не рисунок «как будто чат», а сам чат, только без сети.
+ */
+@SuppressLint("ViewConstructor")
+public class HayoChatPreview extends LinearLayout {
+
+    /** Одно сообщение: текст (может быть с метками оформления) и чьё оно. */
+    public static final class Message {
+        final CharSequence text;
+        final boolean out;
+
+        final TLRPC.Document sticker;
+
+        public Message(CharSequence text, boolean out) {
+            this.text = text;
+            this.out = out;
+            this.sticker = null;
+        }
+
+        /** Сообщение-стикер: настоящий стикер из недавних. */
+        public Message(TLRPC.Document sticker, boolean out) {
+            this.text = "";
+            this.out = out;
+            this.sticker = sticker;
+        }
+    }
+
+    private final LinearLayout messages;
+    private Message[] current;
+    private final boolean withInput;
+    private LinearLayout inputBar;
+    private EditText inputText;
+    private ImageView sendButton;
+
+    public HayoChatPreview(Context context, boolean withInput, Message... list) {
+        super(context);
+        this.withInput = withInput;
+        setWillNotDraw(false);
+        setOrientation(VERTICAL);
+        setPadding(0, dp(10), 0, dp(10));
+        messages = new LinearLayout(context);
+        messages.setOrientation(VERTICAL);
+        addView(messages, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        if (withInput) {
+            buildInput(context);
+        }
+        setMessages(list);
+    }
+
+    /** Подменить сообщения: например, когда переключили вид оформления. */
+    public void setMessages(Message... list) {
+        current = list;
+        messages.removeAllViews();
+        final int account = UserConfig.selectedAccount;
+        final int date = (int) (System.currentTimeMillis() / 1000) - 60 * 5;
+        int id = 1;
+        for (Message m : list) {
+            final TLRPC.TL_message message = new TLRPC.TL_message();
+            message.message = m.text.toString();
+            message.date = date + id * 60;
+            message.dialog_id = 1;
+            message.flags = 257 + 8;
+            message.from_id = new TLRPC.TL_peerUser();
+            message.from_id.user_id = m.out ? UserConfig.getInstance(account).getClientUserId() : 0;
+            message.id = id++;
+            if (m.sticker != null) {
+                final TLRPC.TL_messageMediaDocument media = new TLRPC.TL_messageMediaDocument();
+                media.flags |= 1;
+                media.document = m.sticker;
+                message.media = media;
+            } else {
+                message.media = new TLRPC.TL_messageMediaEmpty();
+            }
+            message.out = m.out;
+            message.peer_id = new TLRPC.TL_peerUser();
+            message.peer_id.user_id = 0;
+            final MessageObject object = new MessageObject(account, message, true, false);
+            object.resetLayout();
+            object.eventId = 1;
+            final ChatMessageCell cell = new ChatMessageCell(context(), account, false, null, null) {
+                @Override
+                public boolean onTouchEvent(MotionEvent event) {
+                    return false;   // это витрина: нажатия в ней ничего не открывают
+                }
+            };
+            cell.setFullyDraw(true);
+            cell.setMessageObject(object, null, false, false, false);
+            messages.addView(cell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        }
+        if (withInput) {
+            placeInput();
+        }
+    }
+
+    private Context context() {
+        return getContext();
+    }
+
+    /** Перерисовать сообщения без пересборки: для ползунков, что двигаются непрерывно. */
+    public void invalidateAll() {
+        for (int i = 0; i < messages.getChildCount(); i++) {
+            messages.getChildAt(i).invalidate();
+        }
+    }
+
+    /** Перечитать настройки поля ввода и перестроить сообщения (цвета темы могли смениться). */
+    public void refresh() {
+        if (current != null) {
+            setMessages(current);
+        }
+        invalidate();
+    }
+
+    // ---------------------------------------------------------------- поле ввода
+
+    private void buildInput(Context context) {
+        inputBar = new LinearLayout(context);
+        inputBar.setOrientation(HORIZONTAL);
+        inputBar.setGravity(Gravity.BOTTOM);
+        inputBar.setPadding(dp(4), dp(4), dp(4), dp(4));
+
+        final LinearLayout field = new LinearLayout(context);
+        field.setOrientation(HORIZONTAL);
+        field.setGravity(Gravity.BOTTOM);
+        final GradientDrawable fieldBg = new GradientDrawable();
+        fieldBg.setCornerRadius(dp(24));
+        fieldBg.setColor(Theme.getColor(Theme.key_chat_messagePanelBackground));
+        field.setBackground(fieldBg);
+
+        final ImageView smile = icon(context, R.drawable.input_smile);
+        field.addView(smile, LayoutHelper.createLinear(48, 48));
+        inputText = new EditText(context);
+        inputText.setBackground(null);
+        inputText.setFocusable(false);
+        inputText.setClickable(false);
+        inputText.setPadding(0, dp(12), 0, dp(12));
+        inputText.setTextColor(Theme.getColor(Theme.key_chat_messagePanelText));
+        inputText.setText(org.telegram.messenger.LocaleController.getString(R.string.HayoPreviewInputText));
+        field.addView(inputText, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f));
+        final ImageView attach = icon(context, R.drawable.msg_input_attach2);
+        field.addView(attach, LayoutHelper.createLinear(48, 48));
+        inputBar.addView(field, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f));
+
+        sendButton = new ImageView(context);
+        sendButton.setScaleType(ImageView.ScaleType.CENTER);
+        sendButton.setImageResource(R.drawable.ic_send);
+        sendButton.setColorFilter(new PorterDuffColorFilter(Theme.getColor(Theme.key_chat_messagePanelVoicePressed), PorterDuff.Mode.SRC_IN));
+        final GradientDrawable sendBg = new GradientDrawable();
+        sendBg.setShape(GradientDrawable.OVAL);
+        sendBg.setColor(Theme.getColor(Theme.key_chat_messagePanelSend));
+        sendButton.setBackground(sendBg);
+        inputBar.addView(sendButton, LayoutHelper.createLinear(48, 48, 6, 0, 0, 0));
+    }
+
+    private ImageView icon(Context context, int res) {
+        final ImageView view = new ImageView(context);
+        view.setScaleType(ImageView.ScaleType.CENTER);
+        view.setImageResource(res);
+        view.setColorFilter(new PorterDuffColorFilter(Theme.getColor(Theme.key_chat_messagePanelIcons), PorterDuff.Mode.SRC_IN));
+        return view;
+    }
+
+    /** Поле сверху или снизу, столько строк и такой текст, как в настройках. */
+    private void placeInput() {
+        if (inputBar.getParent() != null) {
+            removeView(inputBar);
+        }
+        final int raw = MargeletConfig.inputMaxLinesRaw();
+        inputText.setTextSize(TypedValue.COMPLEX_UNIT_DIP, MargeletConfig.inputTextSize());
+        inputText.setMaxLines(raw == 0 ? 8 : raw);
+        inputText.setMinLines(Math.min(raw == 0 ? 4 : raw, 3));
+        final LinearLayout.LayoutParams lp = LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 8, 6, 8, 6);
+        if (MargeletConfig.inputOnTop()) {
+            addView(inputBar, 0, lp);
+        } else {
+            addView(inputBar, lp);
+        }
+    }
+
+    // ---------------------------------------------------------------- фон
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final Drawable drawable = Theme.getCachedWallpaperNonBlocking();
+        if (drawable == null) {
+            canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+            return;
+        }
+        if (drawable instanceof ColorDrawable || drawable instanceof GradientDrawable || drawable instanceof MotionBackgroundDrawable) {
+            drawable.setBounds(0, 0, getMeasuredWidth(), getMeasuredHeight());
+            drawable.draw(canvas);
+        } else if (drawable instanceof BitmapDrawable && drawable.getIntrinsicWidth() > 0) {
+            final float scale = Math.max((float) getMeasuredWidth() / drawable.getIntrinsicWidth(),
+                    (float) getMeasuredHeight() / drawable.getIntrinsicHeight());
+            final int w = (int) Math.ceil(drawable.getIntrinsicWidth() * scale);
+            final int h = (int) Math.ceil(drawable.getIntrinsicHeight() * scale);
+            final int x = (getMeasuredWidth() - w) / 2, y = (getMeasuredHeight() - h) / 2;
+            canvas.save();
+            canvas.clipRect(0, 0, getMeasuredWidth(), getMeasuredHeight());
+            drawable.setBounds(x, y, x + w, y + h);
+            drawable.draw(canvas);
+            canvas.restore();
+        } else {
+            StoryEntry.drawBackgroundDrawable(canvas, drawable, getWidth(), getHeight());
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/HayoDiscordRail.java b/TMessagesProj/src/main/java/org/telegram/ui/HayoDiscordRail.java
new file mode 100644
index 00000000..5b6ed489
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/HayoDiscordRail.java
@@ -0,0 +1,261 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffColorFilter;
+import android.graphics.RectF;
+import android.os.Bundle;
+import android.text.TextPaint;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.margelet.HayoYou;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.AvatarDrawable;
+import org.telegram.ui.Components.BackupImageView;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.util.ArrayList;
+
+/**
+ * Режим Discord: слева колонка чатов иконками, как серверы в Discord, справа
+ * сам чат целиком, с полем ввода. Колонка оборачивает экран чата, сам чат об
+ * этом не знает.
+ */
+@SuppressLint("ViewConstructor")
+public class HayoDiscordRail extends FrameLayout implements NotificationCenter.NotificationCenterDelegate {
+
+    public static final int WIDTH_DP = 76;
+
+    private final ChatActivity chat;
+    private final long currentDialogId;
+    private final int account;
+    private final RecyclerView list;
+    private final ArrayList<Long> dialogs = new ArrayList<>();
+
+    /** Обернуть экран чата колонкой. content — то, что чат сам создал. */
+    public static View wrap(ChatActivity chat, Context context, View content, long dialogId) {
+        final HayoDiscordRail rail = new HayoDiscordRail(context, chat, dialogId);
+        rail.addView(content, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT, Gravity.TOP | Gravity.LEFT, WIDTH_DP, 0, 0, 0));
+        return rail;
+    }
+
+    private HayoDiscordRail(Context context, ChatActivity chat, long dialogId) {
+        super(context);
+        this.chat = chat;
+        this.currentDialogId = dialogId;
+        this.account = UserConfig.selectedAccount;
+        HayoYou.ensureRoles();
+        setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+
+        list = new RecyclerView(context);
+        list.setLayoutManager(new LinearLayoutManager(context));
+        list.setClipToPadding(false);
+        list.setVerticalScrollBarEnabled(false);
+        list.setPadding(0, AndroidUtilities.statusBarHeight + dp(8), 0, dp(16));
+        list.setAdapter(new RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+            @Override
+            public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+                final Item item = new Item(parent.getContext());
+                item.setLayoutParams(new RecyclerView.LayoutParams(dp(WIDTH_DP), dp(viewType == 1 ? 72 : 60)));
+                return new RecyclerView.ViewHolder(item) {};
+            }
+
+            @Override
+            public void onBindViewHolder(RecyclerView.ViewHolder holder, int position) {
+                ((Item) holder.itemView).bind(position == 0 ? 0 : dialogs.get(position - 1), position == 0);
+            }
+
+            @Override
+            public int getItemViewType(int position) {
+                return position == 0 ? 1 : 0;
+            }
+
+            @Override
+            public int getItemCount() {
+                return dialogs.size() + 1;
+            }
+        });
+        addView(list, LayoutHelper.createFrame(WIDTH_DP, LayoutHelper.MATCH_PARENT, Gravity.LEFT));
+        reload();
+    }
+
+    private void reload() {
+        dialogs.clear();
+        final ArrayList<TLRPC.Dialog> all = MessagesController.getInstance(account).getDialogs(0);
+        for (int i = 0; i < all.size() && dialogs.size() < 100; i++) {
+            final long id = all.get(i).id;
+            if (id != 0 && !DialogObject.isFolderDialogId(id)) {
+                dialogs.add(id);
+            }
+        }
+        if (list.getAdapter() != null) {
+            list.getAdapter().notifyDataSetChanged();
+        }
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.dialogsNeedReload);
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.updateInterfaces);
+        reload();
+        // текущий чат в колонке на виду
+        final int at = dialogs.indexOf(currentDialogId);
+        if (at > 3) {
+            list.scrollToPosition(at + 1);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.dialogsNeedReload);
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.updateInterfaces);
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        reload();
+    }
+
+    private void open(long dialogId) {
+        if (dialogId == currentDialogId) {
+            return;
+        }
+        final Bundle args = new Bundle();
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            args.putInt("enc_id", DialogObject.getEncryptedChatId(dialogId));
+        } else if (DialogObject.isUserDialog(dialogId)) {
+            args.putLong("user_id", dialogId);
+        } else {
+            args.putLong("chat_id", -dialogId);
+        }
+        // переключение как в Discord: сразу, без анимации, прошлый чат уходит из стопки
+        chat.presentFragment(new ChatActivity(args), true, true);
+    }
+
+    /** Одна иконка колонки: аватарка, полоска слева, счётчик непрочитанного. */
+    private class Item extends FrameLayout {
+        private final BackupImageView avatar;
+        private final ImageView home;
+        private final AvatarDrawable avatarDrawable = new AvatarDrawable();
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+        private long dialogId;
+        private boolean isHome;
+        private int unread;
+        private boolean mention;
+        private boolean muted;
+
+        Item(Context context) {
+            super(context);
+            setWillNotDraw(false);
+            avatar = new BackupImageView(context);
+            addView(avatar, LayoutHelper.createFrame(48, 48, Gravity.CENTER));
+            home = new ImageView(context);
+            home.setScaleType(ImageView.ScaleType.CENTER);
+            home.setImageResource(R.drawable.margelet_badge_plane);
+            addView(home, LayoutHelper.createFrame(48, 48, Gravity.CENTER));
+            text.setTextSize(dp(11));
+            text.setTypeface(AndroidUtilities.bold());
+            setOnClickListener(v -> {
+                if (isHome) {
+                    chat.finishFragment();
+                } else {
+                    open(dialogId);
+                }
+            });
+        }
+
+        void bind(long dialogId, boolean isHome) {
+            this.dialogId = dialogId;
+            this.isHome = isHome;
+            final boolean selected = !isHome && dialogId == currentDialogId;
+            home.setVisibility(isHome ? VISIBLE : GONE);
+            avatar.setVisibility(isHome ? GONE : VISIBLE);
+            if (isHome) {
+                final android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
+                bg.setCornerRadius(dp(16));
+                bg.setColor(HayoYou.on() ? HayoYou.primaryContainer : Theme.getColor(Theme.key_featuredStickers_addButton));
+                home.setBackground(bg);
+                home.setColorFilter(new PorterDuffColorFilter(HayoYou.on() ? HayoYou.onPrimaryContainer : 0xFFFFFFFF, PorterDuff.Mode.SRC_IN));
+                unread = 0;
+                invalidate();
+                return;
+            }
+            final MessagesController controller = MessagesController.getInstance(account);
+            final TLObject object = DialogObject.isUserDialog(dialogId) ? controller.getUser(dialogId)
+                    : DialogObject.isEncryptedDialog(dialogId) ? controller.getUser(controller.getEncryptedChat(DialogObject.getEncryptedChatId(dialogId)) != null
+                            ? controller.getEncryptedChat(DialogObject.getEncryptedChatId(dialogId)).user_id : 0)
+                    : controller.getChat(-dialogId);
+            if (object instanceof TLRPC.User) {
+                avatarDrawable.setInfo(account, (TLRPC.User) object);
+            } else if (object instanceof TLRPC.Chat) {
+                avatarDrawable.setInfo(account, (TLRPC.Chat) object);
+            }
+            avatar.setForUserOrChat(object, avatarDrawable);
+            // выбранный чат скругляется квадратом, как сервер в Discord
+            avatar.setRoundRadius(selected ? dp(16) : dp(24));
+            final TLRPC.Dialog dialog = controller.dialogs_dict.get(dialogId);
+            unread = dialog != null ? dialog.unread_count : 0;
+            mention = dialog != null && dialog.unread_mentions_count > 0;
+            muted = controller.isDialogMuted(dialogId, 0);
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            final boolean selected = !isHome && dialogId == currentDialogId;
+            // полоска слева: длинная у текущего, короткая у непрочитанного
+            final float h = selected ? dp(40) : unread > 0 && !muted ? dp(8) : 0;
+            if (h > 0) {
+                paint.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+                rect.set(-dp(4), getHeight() / 2f - h / 2f, dp(4), getHeight() / 2f + h / 2f);
+                canvas.drawRoundRect(rect, dp(4), dp(4), paint);
+            }
+        }
+
+        @Override
+        protected void dispatchDraw(Canvas canvas) {
+            super.dispatchDraw(canvas);
+            if (unread <= 0 || isHome) {
+                return;
+            }
+            // счётчик в правом нижнем углу аватарки
+            final String count = unread > 99 ? "99+" : String.valueOf(unread);
+            final float w = Math.max(dp(18), text.measureText(count) + dp(10));
+            final float cx = getWidth() / 2f + dp(18), cy = getHeight() / 2f + dp(18);
+            paint.setColor(Theme.getColor(Theme.key_windowBackgroundGray));
+            rect.set(cx - w / 2f - dp(3), cy - dp(12), cx + w / 2f + dp(3), cy + dp(12));
+            canvas.drawRoundRect(rect, dp(12), dp(12), paint);
+            paint.setColor(mention ? Theme.getColor(Theme.key_chats_unreadCounter)
+                    : Theme.getColor(muted ? Theme.key_chats_unreadCounterMuted : Theme.key_chats_unreadCounter));
+            rect.set(cx - w / 2f, cy - dp(9), cx + w / 2f, cy + dp(9));
+            canvas.drawRoundRect(rect, dp(9), dp(9), paint);
+            text.setColor(Theme.getColor(Theme.key_chats_unreadCounterText));
+            canvas.drawText(count, cx - text.measureText(count) / 2f, cy + dp(4), text);
+        }
+    }
+}
