diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index f9a3639a..ce2ab44d 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -75,6 +75,20 @@ dependencies {
     implementation 'com.stripe:stripe-android:2.0.2'
     implementation 'com.google.mlkit:language-id:17.0.6'
     implementation 'com.android.billingclient:billing:8.0.0'
+    // Движок хуков: встраивание в методы прямо в работающем приложении, без
+    // рута. Нужен для поддержки плагинов, написанных под Xposed.
+    //
+    // Вещь по своей природе хрупкая: она правит внутренности исполнителя java,
+    // а те меняются от версии андроида к версии. Поэтому включается отдельно,
+    // по умолчанию выключен, и при неудаче говорит об этом в консоль, а не
+    // роняет приложение.
+    implementation 'top.canyie.pine:core:0.3.0'
+    // exteraGram plugins with a dex of their own: the Xposed API over Pine, and Kotlin's library they are built against
+    implementation 'top.canyie.pine:xposed:0.2.0'
+    implementation 'org.jetbrains.kotlin:kotlin-stdlib:2.0.21'
+    // плагины экстеры: условия фильтров хуков (MVEL) и наследование java-классов из питона (dexmaker)
+    implementation 'org.mvel:mvel2:2.5.2.Final'
+    implementation 'com.linkedin.dexmaker:dexmaker:2.28.6'
     implementation 'com.google.code.gson:gson:2.11.0'
     implementation 'com.google.guava:guava:31.1-android'
     implementation 'com.google.android.play:integrity:1.3.0'
@@ -135,6 +149,12 @@ android {
     }
 
     defaultConfig {
+        // Ключи API владельца — только в local.properties, в git их нет. Без них
+        // собирается с открытыми ключами телеграма из его исходников.
+        def hayoAppId = getProps("HAYO_APP_ID")
+        def hayoAppHash = getProps("HAYO_APP_HASH")
+        buildConfigField "int", "HAYO_APP_ID", (hayoAppId ? hayoAppId : "4")
+        buildConfigField "String", "HAYO_APP_HASH", "\"" + (hayoAppHash ? hayoAppHash : "014b35b6184100b085b0d0572f9b5103") + "\""
         minSdkVersion 23
         targetSdkVersion 36
 
@@ -142,6 +162,14 @@ android {
 
         multiDexEnabled true
 
+        // Собираем только под arm64. Приложение и так берёт из flavour afat
+        // одну эту архитектуру, а библиотека по умолчанию строила все четыре:
+        // лишние три занимали место и время, и на x86 сборка встала, когда
+        // кончился диск.
+        ndk {
+            abiFilters 'arm64-v8a'
+        }
+
         externalNativeBuild {
             cmake {
                 version '3.22.1'
@@ -156,7 +184,10 @@ android {
             jniDebuggable true
             shrinkResources false
             multiDexEnabled true
-            ndk.debugSymbolLevel = 'FULL'
+            // Отладочные символы нативных библиотек нужны только для
+            // расшифровки крэшей в консоли гугла — их сотни мегабайт, и на
+            // здешнем диске это была разница между сборкой и «нет места».
+            ndk.debugSymbolLevel = 'NONE'
             buildConfigField "String", "BUILD_VERSION_STRING", "\"" + APP_VERSION_NAME + "\""
             buildConfigField "String", "BETA_URL", "\"" + getProps("BETA_PRIVATE_URL") + "\""
             buildConfigField "boolean", "DEBUG_VERSION", "true"
diff --git a/TMessagesProj/proguard-rules.pro b/TMessagesProj/proguard-rules.pro
index 049c7b7a..09b407d4 100644
--- a/TMessagesProj/proguard-rules.pro
+++ b/TMessagesProj/proguard-rules.pro
@@ -55,6 +55,86 @@
 -keep class ru.noties.jlatexmath.** { *; }
 -dontwarn org.scilab.forge.jlatexmath.**
 
+# Плагины. Эти два класса зовут по имени: MargeletPython — из библиотеки,
+# где движка питона нет, а MargeletPluginHost — из самого питона. Для
+# сжимателя оба выглядят никому не нужными, и без этого он их выкинет.
+-keep class org.telegram.margelet.MargeletPython { *; }
+-keep class org.telegram.margelet.MargeletPluginHost { *; }
+# Питон зовёт эти методы по имени: сокращатель о таких вызовах не знает и
+# переименовал бы их, а узнали бы мы об этом только в собранной сборке.
+-keep class org.telegram.margelet.MargeletHooks { *; }
+-keep class org.telegram.margelet.MargeletHooks$Button { *; }
+# Плагин реализует этот интерфейс из питона, то есть по имени. В этой сборке
+# он уцелел и без правила — проверено в собранном APK, — но держаться на
+# везении такие вещи не должны.
+-keep interface org.telegram.margelet.MargeletHooks$FetchCallback { *; }
+# Плагины под Xposed зовут эти классы и методы по имени, из питона. Для
+# сокращателя они выглядят никому не нужными — он и переименует, и выкинет.
+-keep class de.robv.android.xposed.** { *; }
+-keep class top.canyie.pine.** { *; }
+-keep class org.telegram.margelet.MargeletHookEngine { *; }
+# Интерфейс обработчика хуков: питон подставляет под него свой объект
+# по имени. Переименует R8 его методы — плагин соберётся, поставится
+# и не сработает, ровно как было с абстрактным классом.
+-keep interface org.telegram.margelet.MargeletHookCall { *; }
+# Выбор файла: питон подставляет свой объект под этот интерфейс
+# по имени, а сам класс зовёт как jclass. Переименует R8 —
+# плагин соберётся, поставится и не сработает.
+-keep class org.telegram.margelet.MargeletFiles { *; }
+-keep interface org.telegram.margelet.MargeletFiles$Picked { *; }
+-dontwarn top.canyie.pine.**
+# Свой прокси и перевод плагинов экстеры: плагинам полезно видеть их как есть
+# (включён ли прокси, на каком порту), а R8 выкинул бы всё, что не зовёт джава.
+-keep class org.telegram.margelet.MargeletProxy { *; }
+-keep class org.telegram.margelet.MargeletSocket { *; }
+-keep class org.telegram.margelet.MargeletObfuscation { *; }
+-keep class org.telegram.margelet.MargeletObfuscation$* { *; }
+-keep class org.telegram.margelet.MargeletExtera { *; }
+-keep class org.telegram.margelet.MargeletExtera$* { *; }
+-keep class com.chaquo.python.** { *; }
+-dontwarn com.chaquo.python.**
+
 # Use -keep to explicitly keep any other classes shrinking would remove
-#-dontoptimize
-#-dontobfuscate
\ No newline at end of file
+# Телеграм с 13.1 включил оптимизацию и переименование. Нам их выключать
+# обратно: плагины — и наши, и переведённые из exteraGram — достают классы
+# телеграма по именам через jclass, и переименованный класс плагин не найдёт,
+# а сборка об этом не скажет ни слова.
+-dontoptimize
+-dontobfuscate
+
+# exteraGram plugins load their own dex against these: nothing in them may be renamed or dropped
+-keep class kotlin.** { *; }
+-keep class com.exteragram.** { *; }
+-dontwarn kotlin.**
+
+# плагины экстеры: MVEL в фильтрах хуков и dexmaker для наследования классов из питона
+-keep class org.mvel2.** { *; }
+-dontwarn org.mvel2.**
+-keep class com.android.dx.** { *; }
+-dontwarn com.android.dx.**
+-dontwarn java.beans.**
+-dontwarn javax.**
+
+# музыка: питон зовут по имени через отражение
+-keep class org.telegram.margelet.HayoRomajiPython { *; }
+-keep class org.telegram.margelet.HayoMusicPython { *; }
+
+# Плагины exteraGram зовут эти классы телеграма из своего dex и питона.
+# Наш код зовёт не всё, и R8 вырезал бы «лишнее», а у плагина был бы краш.
+-keep class org.telegram.ui.Components.UItem { *; }
+-keep class org.telegram.ui.Components.UItem$* { *; }
+-keep class org.telegram.ui.Components.UniversalAdapter { *; }
+-keep class org.telegram.ui.Components.UniversalRecyclerView { *; }
+-keep class org.telegram.ui.Components.BulletinFactory { *; }
+-keep class org.telegram.ui.Components.Bulletin { *; }
+-keep class org.telegram.ui.Components.ItemOptions { *; }
+-keep class org.telegram.ui.Components.LayoutHelper { *; }
+-keep class org.telegram.ui.ActionBar.Theme { *; }
+-keep class org.telegram.ui.ActionBar.AlertDialog { *; }
+-keep class org.telegram.ui.ActionBar.AlertDialog$* { *; }
+-keep class org.telegram.ui.ActionBar.BaseFragment { *; }
+-keep class org.telegram.ui.ActionBar.ActionBar { *; }
+-keep class org.telegram.ui.Cells.** { *; }
+-keepclassmembers class org.telegram.ui.ChatActivity { *; }
+-keepclassmembers class org.telegram.ui.ProfileActivity { *; }
+-keepclassmembers class org.telegram.ui.LaunchActivity { *; }
