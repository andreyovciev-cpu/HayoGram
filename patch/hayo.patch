+    // поиск
+
+    public void openSearch() {
+        if (searching) return;
+        searching = true;
+        searchPanel.setVisibility(VISIBLE);
+        statusBackground.setVisibility(GONE);
+        searchPanel.setAlpha(0f);
+        searchPanel.setTranslationY(-dp(12));
+        searchPanel.animate().alpha(1f).translationY(0).setDuration(220).setInterpolator(CubicBezierInterpolator.EASE_OUT_QUINT).start();
+        applyPadding();
+        update();
+        listView.scrollToPosition(0);
+        searchField.requestFocus();
+        AndroidUtilities.runOnUIThread(() -> AndroidUtilities.showKeyboard(searchField), 120);
+    }
+
+    public void closeSearch() {
+        if (!searching) return;
+        searching = false;
+        AndroidUtilities.hideKeyboard(searchField);
+        AndroidUtilities.cancelRunOnUIThread(searchRunnable);
+        searchPanel.setVisibility(GONE);
+        statusBackground.setVisibility(VISIBLE);
+        if (tgSearch != null) tgSearch.cancel();
+        tgSearch = null;
+        onlineResult = null;
+        onlineLoading = false;
+        onlineSeq++;
+        query = "";
+        searchField.setText("");
+        applyPadding();
+        update();
+    }
+
+    public boolean isSearching() {
+        return searching;
+    }
+
+    private void setSource(int which) {
+        if (source == which) return;
+        source = which;
+        updateChips();
+        query = "";
+        runSearch();
+    }
+
+    private void updateChips() {
+        final int primary = color(Theme.key_featuredStickers_addButton);
+        final int onPrimary = color(Theme.key_featuredStickers_buttonText);
+        final int text = color(Theme.key_windowBackgroundWhiteBlackText);
+        final int card = color(Theme.key_windowBackgroundWhite);
+        for (int i = 0; i < chips.length; i++) {
+            final TextView chip = chips[i];
+            if (chip == null) continue;
+            final boolean on = i == source;
+            chip.setTextColor(on ? onPrimary : text);
+            chip.setBackground(Theme.createSimpleSelectorRoundRectDrawable(dp(18), on ? primary : card, Theme.multAlpha(on ? onPrimary : text, 0.15f)));
+        }
+    }
+
+    private void runSearch() {
+        final String q = searchField.getText() == null ? "" : searchField.getText().toString().trim();
+        if (q.equals(query) && (source == SRC_TG ? tgSearch != null : onlineResult != null || onlineLoading)) return;
+        query = q;
+        if (tgSearch != null) tgSearch.cancel();
+        tgSearch = null;
+        onlineResult = null;
+        onlineLoading = false;
+        final int seq = ++onlineSeq;
+        if (!TextUtils.isEmpty(q)) {
+            if (source == SRC_TG) {
+                tgSearch = new HayoMusicChats(UserConfig.selectedAccount, q);
+                tgSearch.setOnChange(this::update);
+                tgSearch.loadMore();
+            } else {
+                onlineLoading = true;
+                HayoMusicOnline.search(source == SRC_SC ? HayoMusic.SC : HayoMusic.YT, q, 25, result -> {
+                    if (seq != onlineSeq) return;
+                    onlineLoading = false;
+                    onlineResult = result;
+                    update();
+                });
+            }
+        }
+        update();
+        listView.scrollToPosition(0);
+    }
+
+    // нажатия
+
+    private String sourceName() {
+        if (!searching) return LocaleController.getString(R.string.HayoFromChats);
+        return query;
+    }
+
+    private void onClick(View view, int position, float x) {
+        if (position < 0 || position >= rows.size()) return;
+        final Row row = rows.get(position);
+        switch (row.type) {
+            case T_TRACK:
+                if (x > HayoTrackCell.moreEdge(view)) {
+                    HayoMusicActions.menu(host.fragment(), view, row.item.track, row.item.message, host.bulletins(), null, this::update);
+                } else if (HayoTrackCell.inLike(view, x)) {
+                    HayoMusicActions.like(row.item.track, row.item.message, null, this::update);
+                } else {
+                    playRow(row);
+                }
+                break;
+            case T_LIKED: {
+                // кнопку «играть» нажимает её собственный обработчик
+                final View play = ((LikedCard) view).play;
+                if (play.getVisibility() == VISIBLE && x >= play.getLeft() - dp(8) && x <= play.getRight() + dp(8)) break;
+                host.fragment().presentFragment(new HayoPlaylistActivity(HayoMusic.LIKED));
+                break;
+            }
+            case T_SECTION:
+                if (row.action == A_RECENT) {
+                    host.fragment().presentFragment(new HayoPlaylistActivity(HayoPlaylistActivity.RECENT));
+                } else if (row.action == A_RECS) {
+                    loadRecsIfNeeded(true);
+                }
+                break;
+            case T_NOTE:
+                if (row.action == A_RETRY_RECS) {
+                    loadRecsIfNeeded(true);
+                } else if (row.action == A_RETRY_CHATS && chats != null) {
+                    chats.failed = false;
+                    chats.loadMore();
+                    update();
+                } else if (row.action == A_RETRY_SEARCH) {
+                    query = "\u0000";
+                    runSearch();
+                }
+                break;
+        }
+    }
+
+    private boolean onLongClick(View view, int position) {
+        if (position < 0 || position >= rows.size()) return false;
+        final Row row = rows.get(position);
+        if (row.type != T_TRACK) return false;
+        HayoMusicActions.menu(host.fragment(), view, row.item.track, row.item.message, host.bulletins(), null, this::update);
+        return true;
+    }
+
+    private boolean openPlayerIfCurrent(String key) {
+        if (HayoMusic.isPlaying(key) && MediaController.getInstance().getPlayingMessageObject() != null
+                && !MediaController.getInstance().isMessagePaused()) {
+            return HayoPlayer.open(getContext());
+        }
+        return false;
+    }
+
+    private void playRow(Row row) {
+        if (openPlayerIfCurrent(row.item.key)) return;
+        if (row.item.track != null) {
+            HayoMusic.play(new ArrayList<>(onlineResult.items), row.index, null, sourceName());
+        } else {
+            final ArrayList<MessageObject> list = searching && tgSearch != null ? tgSearch.items : chats.items;
+            HayoMusic.playMessages(list, row.index, sourceName());
+        }
+        refreshVisible();
+    }
+
+    private void createPlaylist() {
+        HayoPlaylistPicker.askName(getContext(), LocaleController.getString(R.string.HayoPlaylistNew), "", name -> {
+            final HayoMusic.Playlist playlist = HayoMusic.create(name);
+            host.fragment().presentFragment(new HayoPlaylistActivity(playlist.id));
+        });
+    }
+
+    private void playlistMenu(View anchor, HayoMusic.Playlist playlist) {
+        final org.telegram.ui.Components.ItemOptions options = org.telegram.ui.Components.ItemOptions.makeOptions(host.fragment(), anchor);
+        options.addIf(!playlist.tracks.isEmpty(), R.drawable.hayo_ic_play_arrow_fill, LocaleController.getString(R.string.HayoPlayAll),
+                () -> HayoMusic.play(new ArrayList<>(playlist.tracks), 0, false, playlist.name));
+        options.addIf(!playlist.tracks.isEmpty(), R.drawable.hayo_ic_shuffle, LocaleController.getString(R.string.HayoShuffle),
+                () -> HayoMusic.play(new ArrayList<>(playlist.tracks), -1, true, playlist.name));
+        options.add(R.drawable.hayo_ic_edit, LocaleController.getString(R.string.HayoPlaylistRename), () ->
+                HayoPlaylistPicker.askName(getContext(), LocaleController.getString(R.string.HayoPlaylistRename), playlist.name, name -> HayoMusic.rename(playlist, name)));
+        options.add(R.drawable.hayo_ic_delete, LocaleController.getString(R.string.HayoPlaylistDelete), true, () -> HayoMusic.delete(playlist));
+        options.show();
+    }
