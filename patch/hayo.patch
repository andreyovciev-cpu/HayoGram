+                toggled(view, MargeletConfig.discordMode());
+                // ячейки и разметка сообщений строятся при открытии чата: перестраиваем экраны
+                if (parentLayout != null) {
+                    parentLayout.rebuildAllFragmentViews(false, false);
+                }
+                break;
+            case ID_OWN_PLAYER:
+                org.telegram.margelet.HayoMusic.setOwnPlayer(!org.telegram.margelet.HayoMusic.ownPlayer());
+                toggled(view, org.telegram.margelet.HayoMusic.ownPlayer());
+                break;
+            case ID_MUSIC_TAB:
+                // вкладка появится или уйдёт, когда главный экран снова станет виден
+                org.telegram.margelet.HayoMusic.setMusicTab(!org.telegram.margelet.HayoMusic.musicTab());
+                toggled(view, org.telegram.margelet.HayoMusic.musicTab());
+                break;
+            case ID_MUSIC:
+                presentFragment(new HayoMusicActivity());
+                break;
+            case ID_HIDE_ALL:
+                MargeletConfig.setHideAllChatsTab(!MargeletConfig.hideAllChatsTab());
+                NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.dialogFiltersUpdated);
+                toggled(view, MargeletConfig.hideAllChatsTab());
+                break;
+            case ID_TRACKS:
