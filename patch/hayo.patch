         release {
-            storeFile file("../TMessagesProj/config/release.keystore")
-            storePassword RELEASE_STORE_PASSWORD
-            keyAlias RELEASE_KEY_ALIAS
-            keyPassword RELEASE_KEY_PASSWORD
+            // Свой ключ Hayo Gram лежит только у владельца: путь и пароли в
+            // local.properties, которого нет в git. Без него сборка всё равно
+            // соберётся — открытым ключом телеграма, как раньше, но поверх
+            // настоящей Hayo Gram такую уже не поставить. Так и должно быть:
+            // ключ, который есть у всех, позволял кому угодно выпустить
+            // «обновление» и забрать чужую переписку.
+            def own = new Properties()
+            def localFile = rootProject.file("local.properties")
+            if (localFile.exists()) {
+                localFile.withInputStream { own.load(it) }
+            }
+            if (own.getProperty("HAYO_STORE_FILE") != null) {
+                storeFile file(own.getProperty("HAYO_STORE_FILE"))
+                storePassword own.getProperty("HAYO_STORE_PASSWORD")
+                keyAlias own.getProperty("HAYO_KEY_ALIAS")
+                keyPassword own.getProperty("HAYO_KEY_PASSWORD")
+            } else {
+                storeFile file("../TMessagesProj/config/release.keystore")
+                storePassword RELEASE_STORE_PASSWORD
+                keyAlias RELEASE_KEY_ALIAS
+                keyPassword RELEASE_KEY_PASSWORD
+            }
         }
     }
 
