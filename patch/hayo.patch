+    /** Обложка с кольцом прогресса скачивания поверх. */
+    private static class CoverBox extends FrameLayout {
+        int ringColor;
+        float progress = -1;
+        private final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+
+        CoverBox(Context context) {
+            super(context);
+            ring.setStyle(Paint.Style.STROKE);
+            ring.setStrokeCap(Paint.Cap.ROUND);
+            ring.setStrokeWidth(dp(3));
+        }
+
+        void setProgress(float p) {
+            if (progress == p) return;
+            progress = p;
+            invalidate();
+        }
+
+        @Override
+        protected void dispatchDraw(Canvas canvas) {
+            super.dispatchDraw(canvas);
+            if (progress < 0) return;
+            // затемняем обложку и рисуем кольцо скачивания
+            rect.set(0, 0, getWidth(), getHeight());
+            canvas.drawRoundRect(rect, dp(12), dp(12), fill(0x80000000));
+            final float pad = Math.min(getWidth(), getHeight()) * 0.22f;
+            rect.set(pad, pad, getWidth() - pad, getHeight() - pad);
+            ring.setColor(0x40FFFFFF);
+            canvas.drawArc(rect, 0, 360, false, ring);
+            ring.setColor(0xFFFFFFFF);
+            canvas.drawArc(rect, -90, Math.max(8, 360 * progress), false, ring);
+        }
+
+        private final Paint fillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        private Paint fill(int color) {
+            fillPaint.setColor(color);
+            return fillPaint;
+        }
+    }
+
+    /** Фабрика для списков на UniversalAdapter: в item.object лежит трек. */
+    public static class Factory extends UItem.UItemFactory<HayoTrackCell> {
+        static { setup(new Factory()); }
+
+        @Override
+        public HayoTrackCell createView(Context context, RecyclerListView listView, int currentAccount, int classGuid, Theme.ResourcesProvider resourcesProvider) {
+            return new HayoTrackCell(context);
+        }
+
+        @Override
+        public void bindView(View view, UItem item, boolean divider, UniversalAdapter adapter, UniversalRecyclerView listView) {
+            final HayoTrackCell cell = (HayoTrackCell) view;
+            if (item.object instanceof HayoMusic.Track) {
+                cell.set((HayoMusic.Track) item.object, (MessageObject) item.object2, item.checked);
+                cell.setProgress(HayoMusicOnline.progress(((HayoMusic.Track) item.object).key()));
+            } else {
+                cell.set((MessageObject) item.object2, item.checked);
+            }
+        }
+
+        public static UItem of(int id, HayoMusic.Track track, MessageObject message, boolean current) {
+            final UItem item = UItem.ofFactory(Factory.class);
+            item.id = id;
+            item.object = track;
+            item.object2 = message;
+            item.checked = current;
+            return item;
+        }
+
+        @Override
+        public boolean equals(UItem a, UItem b) {
+            return a.object == b.object;
+        }
+
+        @Override
+        public boolean contentsEquals(UItem a, UItem b) {
+            return a.object == b.object && a.checked == b.checked;
+        }
+    }
+}
