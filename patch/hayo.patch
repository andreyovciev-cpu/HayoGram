+package com.exteragram.messenger.plugins;
+
+import java.io.File;
+
+/**
+ * Питоновский движок экстеры. У Hayo плагины поднимает свой хост, поэтому
+ * здесь только то, о чём спрашивают плагины-библиотеки: плагин ли это файл.
+ * Загрузить или выгрузить плагин на ходу Hayo не умеет, и здесь это видно.
+ */
+public class PythonPluginsEngine {
+
+    public boolean isPlugin(File file, Object callback) {
